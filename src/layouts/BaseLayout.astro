---
import SpeedInsights from '@vercel/speed-insights/astro';
import '@styles/global.css';
import NavigationBar from '@components/NavigationBar.astro';
import LiveChat from '@components/LiveChat.astro';
import Footer from '@components/Footer.astro';
import { SEO } from 'astro-seo';
import { SEOS } from '@lib/seos';
import Analytics from '@vercel/analytics/astro';

interface Props {
  url?: string;
  title?: string;
  ogimage?: ImageMetadata | string;
  description?: string;
  structuredData?: object;
  hideNav?: boolean;
  hideFooter?: boolean;
}

const {
  url = SEOS.url,
  title = SEOS.title,
  ogimage = SEOS.image,
  description = SEOS.description,
  structuredData,
  hideNav = false,
  hideFooter = false,
} = Astro.props;

const imageIsString = typeof ogimage === 'string';
const imageUrl = imageIsString ? ogimage : ogimage.src;
const absoluteImageUrl = new URL(imageUrl, Astro.site ?? SEOS.url).href;
const imageWidth = imageIsString ? 1200 : ogimage.width;
const imageHeight = imageIsString ? 675 : ogimage.height;

// Default Organization structured data
const defaultStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SEOS.legalName,
  alternateName: SEOS.name,
  url: SEOS.url ?? 'https://kriya.click',
  logo: `${SEOS.url ?? 'https://kriya.click'}/favicon.svg`,
  description: SEOS.description,
  email: SEOS.email,
  telephone: SEOS.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SEOS.address.streetAddress,
    addressLocality: SEOS.address.addressLocality,
    addressRegion: SEOS.address.addressRegion,
    postalCode: SEOS.address.postalCode,
    addressCountry: SEOS.address.addressCountry,
  },
  sameAs: SEOS.socialLinks,
  knowsAbout: [
    'Website Development',
    'Software Development',
    'IT Consulting',
    'Cloud Hosting',
    'IT Infrastructure',
    'Data Migration',
    'IT Procurement',
    'SaaS Implementation',
    'Digital Transformation',
  ],
  areaServed: {
    '@type': 'Country',
    name: 'Indonesia',
  },
  foundingLocation: {
    '@type': 'Place',
    name: 'Jakarta, Indonesia',
  },
};

const finalStructuredData = structuredData ?? defaultStructuredData;
---

<!doctype html>
<html lang="id" class="light">
  <meta charset="UTF-8" />
  <meta name="robots" content="max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <SEO
    title={title.concat(' | Kriya')}
    description={description}
    openGraph={{
      basic: {
        title: title.concat(' | Kriya'),
        type: 'website',
        image: absoluteImageUrl,
        url: url,
      },
      optional: {
        description: description,
        locale: 'id_ID',
        siteName: 'Kriya',
      },
      image: {
        secureUrl: absoluteImageUrl,
        alt: title.concat(' | Kriya'),
        type: 'image/png',
        width: imageWidth,
        height: imageHeight,
      },
    }}
  />
  <script type="application/ld+json" set:html={JSON.stringify(finalStructuredData)} />
  <script>
    import '@scripts/lenisSmoothScroll.js';
  </script>

  <body
    class="bg-(--color-deep-space-blue-50) dark:bg-(--color-deep-space-blue-900)"
    cz-shortcut-listen="true"
  >
  
    {!hideNav && <NavigationBar />}
    <main id="content">
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <LiveChat />

    <!-- Preline UI -->
    <script>
      import 'preline/preline.js';
    </script>

  </body>
</html>
