---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ChevronLeft } from '@lucide/astro';
---

<BaseLayout
  title="Halaman Tidak Ditemukan"
  description="Halaman yang Anda cari tidak tersedia. Kembali ke halaman utama Kriya untuk menemukan layanan IT dan solusi digital yang Anda butuhkan."
>
  <main id="content">
    <div class="mx-auto flex size-full max-w-3xl flex-col">
      <div class="px-4 py-10 text-center sm:px-6 lg:px-8">
        <h1 class="block text-7xl font-bold text-gray-800 sm:text-9xl dark:text-white">404</h1>
        <p class="mt-3 text-gray-600 dark:text-neutral-400">Ups, ada yang tidak beres.</p>
        <p class="text-gray-600 dark:text-neutral-400">
          Maaf, halaman yang Anda cari tidak ditemukan.
        </p>
        <div class="mt-5 flex flex-col items-center justify-center gap-2 sm:flex-row sm:gap-3">
          <a
            class="inline-flex min-h-[44px] w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-(--color-steel-blue-800) px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-(--color-steel-blue-700) focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:ring-offset-2 focus-visible:outline-hidden disabled:pointer-events-none disabled:opacity-50 sm:w-auto dark:bg-(--color-steel-blue-700) dark:hover:bg-(--color-steel-blue-600)"
            href="/"
          >
            <ChevronLeft class="size-4 shrink-0" />
            Kembali ke Beranda
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
