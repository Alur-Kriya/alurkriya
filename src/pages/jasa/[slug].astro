---
import BaseLayout from '@layouts/BaseLayout.astro';
import { services } from '@contents/services/services.mjs';
import { faq } from '@contents/services/faq.mjs';
import { approach } from '@contents/services/approach.mjs';
import HeroBanner from '@components/services/HeroBanner.astro';
import Features from '@components/services/Features.astro';
import Approach from '@components/services/Approach.astro';
import Faq from '@components/services/Faq.astro';
import RichSnipetts from '@components/RichSnippets.astro';
import { SEOS } from '@lib/seos';

export async function getStaticPaths() {
  return services.map((url) => ({
    params: { slug: url.slug },
  }));
}

// Get the slug from Astro's params
const { slug } = Astro.params;
// Find the matching layanan item
const content = services.find((item: any) => item.slug === slug);

if (!content) {
  throw new Error(`Layanan jasa with slug "${slug}" not found`);
}

const faqData = faq.find((item: any) => item.slug === slug);

if (!faqData) {
  throw new Error(`FAQ not found`);
}

const approachData = approach.find((item: any) => item.slug === slug);

if (!approachData) {
  throw new Error(`Services not found`);
}

// Service schema markup (schema.org)
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: content.heading,
  alternateName: content.title,
  description: content.description,
  url: `${SEOS.url}/jasa/${slug}`,
  provider: {
    '@type': 'Organization',
    name: SEOS.legalName,
    alternateName: SEOS.name,
    url: SEOS.url,
    logo: `${SEOS.url}/favicon.svg`,
    email: SEOS.email,
    telephone: SEOS.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SEOS.address.streetAddress,
      addressLocality: SEOS.address.addressLocality,
      addressRegion: SEOS.address.addressRegion,
      postalCode: SEOS.address.postalCode,
      addressCountry: SEOS.address.addressCountry,
    },
  },
  areaServed: {
    '@type': 'Country',
    name: 'Indonesia',
  },
  serviceType: content.heading,
  category: 'Information Technology',
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: `${SEOS.url}/kontak`,
    servicePhone: SEOS.phone,
    serviceSmsNumber: SEOS.phone,
    availableLanguage: {
      '@type': 'Language',
      name: 'Indonesian',
    },
  },
};

interface Props {
  title?: string;
  description?: string;
}
---

<BaseLayout title={content.title} description={content.description} ogimage={content.ogimage} structuredData={serviceSchema}>
  <HeroBanner {...content} />

  <Features {...content} />

  <Approach {...approachData} />

  <Faq {...faqData} />

  <RichSnipetts />
</BaseLayout>
