---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroBanner from '@components/pages/HeroBanner.astro';
import RichSnippets from '@components/RichSnippets.astro';
import { partners } from '@contents/partners/partners.mjs';
import { pages } from '@contents/pages/pages.mjs';
import {
  Check,
  ArrowRight,
  ShieldCheck,
  Wrench,
  ArrowLeftRight,
  Headphones,
  MessageCircle,
} from '@lucide/astro';

const pageData = pages.find((item: any) => item.slug === 'kemitraan');

const pageTitle = pageData?.title
  ? `${pageData.title} & Partner Strategis`
  : 'Kemitraan & Partner Strategis';
const pageDesc =
  pageData?.desc ||
  'Kenali mitra dan partner strategis Kriya. Kolaborasi teknologi bersama Google Cloud, Microsoft Azure, dan Canonical Ubuntu untuk solusi digital bisnis terbaik.';

// Structured data Schema.org
const partnerSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Mitra & Partner Strategis PT. Alur Kriya Teknologi',
  description: pageDesc,
  itemListElement: partners.map((partner, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Organization',
      name: partner.name,
      url: `https://kriya.click/partners/${partner.slug}`,
      description: partner.shortDesc,
    },
  })),
};
---

<BaseLayout title={pageTitle} description={pageDesc} structuredData={partnerSchema}>
  <!-- Hero Banner -->
  <HeroBanner
    heading={pageData?.heading
      ? `${pageData.heading} & Partner Strategis`
      : 'Kemitraan & Partner Strategis'}
    description={pageDesc}
  />

  <!-- Main Section: Partner Ecosystem -->
  <section class="partner-section py-16 lg:py-24">
    <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="mx-auto max-w-3xl text-center">
        <span
          class="inline-block rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold tracking-wider text-blue-700 uppercase dark:bg-blue-950/60 dark:text-blue-300"
        >
          Ekosistem Teknologi
        </span>
        <h2
          class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
        >
          Mitra Platform & Solusi Global Terpercaya
        </h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-neutral-400">
          Kami mengintegrasikan teknologi dari para pemimpin industri dunia untuk memastikan solusi
          cloud, infrastruktur, dan software bisnis Anda memiliki performa terbaik, aman, dan siap
          bertumbuh.
        </p>
      </div>

      <!-- Partners Grid -->
      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          partners.map((partner) => (
            <div class="group relative flex flex-col justify-between rounded-2xl border border-gray-200 bg-white p-6 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950) dark:hover:border-blue-900/60">
              <div>
                <div class="flex items-center justify-between gap-2 border-b border-gray-100 pb-5 dark:border-neutral-800">
                  <span class="inline-flex items-center rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700 dark:bg-neutral-800 dark:text-neutral-300">
                    {partner.badge}
                  </span>
                  <span class="text-xs font-medium text-gray-400 dark:text-neutral-500">
                    Partner Resmi
                  </span>
                </div>

                <div class="flex h-20 items-center justify-center py-4">
                  <img
                    src={partner.logo}
                    alt={`Logo ${partner.name}`}
                    class="max-h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>

                <div class="mt-3">
                  <div class="text-xs font-semibold tracking-wide text-blue-600 uppercase dark:text-blue-400">
                    {partner.category}
                  </div>
                  <h3 class="mt-1 text-xl font-bold text-gray-900 dark:text-white">
                    {partner.name}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
                    {partner.shortDesc}
                  </p>
                </div>

                <div class="mt-5 space-y-2 border-t border-gray-100 pt-4 dark:border-neutral-800">
                  <span class="text-xs font-semibold tracking-wider text-gray-500 uppercase dark:text-neutral-400">
                    Fokus Solusi Kriya:
                  </span>
                  <ul class="space-y-1.5 text-xs text-gray-600 dark:text-neutral-300">
                    {partner.capabilities.slice(0, 3).map((item: string) => (
                      <li class="flex items-start gap-2">
                        <Check class="mt-0.5 size-3.5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-400" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="mt-7 border-t border-gray-100 pt-4 dark:border-neutral-800">
                <a
                  href={`/partners/${partner.slug}`}
                  class="inline-flex w-full items-center justify-center gap-x-2 rounded-xl bg-gray-50 px-4 py-2.5 text-sm font-semibold text-(--color-steel-blue-800) transition-all duration-200 hover:bg-(--color-steel-blue-800) hover:text-white dark:bg-neutral-800/80 dark:text-neutral-200 dark:hover:bg-(--color-steel-blue-700) dark:hover:text-white"
                >
                  Detail Solusi & Lisensi
                  <ArrowRight class="size-4 shrink-0" />
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Value Section: Why Choose Partner Solutions with Kriya -->
  <section class="bg-gray-50/80 py-16 lg:py-20 dark:bg-(--color-deep-space-blue-950)/60">
    <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span
          class="inline-block rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold tracking-wider text-blue-700 uppercase dark:bg-blue-950/60 dark:text-blue-300"
        >
          Nilai Tambah Kami
        </span>
        <h2
          class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
        >
          Mengapa Mengadopsi Solusi Mitra Melalui Kriya?
        </h2>
        <p class="mt-3 text-base text-gray-600 dark:text-neutral-400">
          Kami bukan sekadar reseller lisensi — Kriya adalah konsultan dan mitra implementasi teknis
          yang memastikan setiap investasi teknologi memberikan hasil maksimal bagi bisnis Anda.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Benefit 1 -->
        <div
          class="rounded-xl border border-gray-200 bg-white p-6 transition-all hover:shadow-md dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)"
        >
          <div
            class="flex size-12 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/50 dark:text-blue-400"
          >
            <ShieldCheck class="size-6" />
          </div>
          <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-white">
            Lisensi Resmi & Transparan
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
            Akses langsung ke paket lisensi original dari prinsipal resmi dengan struktur biaya
            transparan dan faktur pajak lengkap di Indonesia.
          </p>
        </div>

        <!-- Benefit 2 -->
        <div
          class="rounded-xl border border-gray-200 bg-white p-6 transition-all hover:shadow-md dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)"
        >
          <div
            class="flex size-12 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400"
          >
            <Wrench class="size-6" />
          </div>
          <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-white">
            Implementasi & Setup Terpandu
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
            Dikonfigurasi langsung oleh engineer profesional Kriya sesuai best practice keamanan
            arsitektur cloud dan efisiensi resource.
          </p>
        </div>

        <!-- Benefit 3 -->
        <div
          class="rounded-xl border border-gray-200 bg-white p-6 transition-all hover:shadow-md dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)"
        >
          <div
            class="flex size-12 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-400"
          >
            <ArrowLeftRight class="size-6" />
          </div>
          <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-white">
            Migrasi Data Minim Downtime
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
            Kami merancang alur migrasi database, email, dan sistem aplikasi dengan downtime yang
            terkontrol ketat agar operasional bisnis tetap berjalan lancar.
          </p>
        </div>

        <!-- Benefit 4 -->
        <div
          class="rounded-xl border border-gray-200 bg-white p-6 transition-all hover:shadow-md dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)"
        >
          <div
            class="flex size-12 items-center justify-center rounded-lg bg-purple-50 text-purple-600 dark:bg-purple-950/50 dark:text-purple-400"
          >
            <Headphones class="size-6" />
          </div>
          <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-white">
            Support Teknis Lokal 24/7
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
            Dukungan purna-jual dan troubleshooting langsung dalam Bahasa Indonesia oleh tim teknis
            lokal dengan respon cepat dan SLA yang terjamin.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section: 4 Simple Steps -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span
          class="inline-block rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold tracking-wider text-blue-700 uppercase dark:bg-blue-950/60 dark:text-blue-300"
        >
          Metodologi Kolaborasi
        </span>
        <h2
          class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
        >
          Tahapan Implementasi Solusi Mitra
        </h2>
        <p class="mt-3 text-base text-gray-600 dark:text-neutral-400">
          Alur kerja yang terstruktur dan teruji untuk memastikan adopsi teknologi berjalan tepat
          sasaran, hemat biaya, dan minim risiko.
        </p>
      </div>

      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Step 1 -->
        <div
          class="relative rounded-xl border border-gray-200 bg-white p-6 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)"
        >
          <div class="text-3xl font-black text-blue-600/30 dark:text-blue-400/20">01</div>
          <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">
            Assessment & Konsultasi
          </h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">
            Sesi konsultasi mendalam untuk memahami alur kerja, beban sistem, dan rekomendasi paket
            partner yang paling efisien.
          </p>
        </div>

        <!-- Step 2 -->
        <div
          class="relative rounded-xl border border-gray-200 bg-white p-6 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)"
        >
          <div class="text-3xl font-black text-blue-600/30 dark:text-blue-400/20">02</div>
          <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">Roadmap & Pengadaan</h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">
            Penyusunan arsitektur sistem, jadwal deployment, serta aktivasi lisensi resmi dengan
            skema penagihan yang fleksibel.
          </p>
        </div>

        <!-- Step 3 -->
        <div
          class="relative rounded-xl border border-gray-200 bg-white p-6 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)"
        >
          <div class="text-3xl font-black text-blue-600/30 dark:text-blue-400/20">03</div>
          <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">Deployment & Migrasi</h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">
            Eksekusi instalasi teknis, transfer data aman, integrasi API sistem, dan pengujian
            performa menyeluruh sebelum go-live.
          </p>
        </div>

        <!-- Step 4 -->
        <div
          class="relative rounded-xl border border-gray-200 bg-white p-6 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)"
        >
          <div class="text-3xl font-black text-blue-600/30 dark:text-blue-400/20">04</div>
          <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">
            Training & Monitoring
          </h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">
            Pelatihan tim internal perusahaan serta monitoring performa berkelanjutan dengan
            dukungan teknis responsif 24/7.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section: Consultation -->
  <section class="bg-(--color-steel-blue-800) py-16 text-white dark:bg-(--color-steel-blue-950)">
    <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Ingin Berkonsultasi Mengenai Solusi Mitra Kriya?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-blue-100">
        Diskusikan kebutuhan cloud hosting, lisensi software bisnis, atau migrasi infrastruktur Anda
        bersama konsultan spesialis Kriya secara gratis.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="https://wa.me/6285117428800?text=Halo%20Kriya,%20saya%20ingin%20konsultasi%20mengenai%20solusi%20kemitraan%20teknologi"
          class="inline-flex items-center gap-x-2 rounded-xl bg-white px-6 py-3.5 text-sm font-semibold text-gray-900 shadow-md transition-all hover:bg-gray-100 focus:outline-hidden"
          target="_blank"
          rel="noopener noreferrer"
        >
          <MessageCircle class="size-4 text-emerald-600" />
          Konsultasi Kemitraan via WhatsApp
        </a>
        <a
          href="/kontak"
          class="inline-flex items-center gap-x-2 rounded-xl border border-white/40 bg-transparent px-6 py-3.5 text-sm font-semibold text-white transition-all hover:bg-white/10 focus:outline-hidden"
        >
          Hubungi Tim Kriya
        </a>
      </div>
    </div>
  </section>

  <!-- RichSnippets -->
  <RichSnippets />
</BaseLayout>
