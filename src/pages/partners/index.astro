---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroBanner from '@components/pages/HeroBanner.astro';
import RichSnippets from '@components/RichSnippets.astro';
import { partners } from '@contents/partners/partners.mjs';
import { pages } from '@contents/pages/pages.mjs';

const pageData = pages.find((item: any) => item.slug === 'kemitraan');

const pageTitle = pageData?.title ? `${pageData.title} & Partner Strategis` : 'Kemitraan & Partner Strategis';
const pageDesc =
  pageData?.desc ||
  'Kenali mitra dan partner strategis Kriya. Kolaborasi teknologi bersama Google Cloud, Microsoft Azure, dan Canonical Ubuntu untuk solusi digital bisnis terbaik.';

// Structured data Schema.org
const partnerSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Mitra & Partner Strategis PT. Alur Kriya Teknologi',
  description: pageDesc,
  itemListElement: partners.map((partner, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Organization',
      name: partner.name,
      url: `https://kriya.click/partners/${partner.slug}`,
      description: partner.shortDesc,
    },
  })),
};
---

<BaseLayout title={pageTitle} description={pageDesc} structuredData={partnerSchema}>
  <!-- Hero Banner -->
  <HeroBanner
    heading={pageData?.heading ? `${pageData.heading} & Partner Strategis` : 'Kemitraan & Partner Strategis'}
    description={pageDesc}
  />

  <!-- Main Section: Partner Ecosystem -->
  <section class="partner-section py-16 lg:py-24">
    <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-block rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold tracking-wider text-blue-700 uppercase dark:bg-blue-950/60 dark:text-blue-300">
          Ekosistem Teknologi
        </span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Mitra Platform & Solusi Global Terpercaya
        </h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-neutral-400">
          Kami mengintegrasikan teknologi dari para pemimpin industri dunia untuk memastikan solusi cloud, infrastruktur, dan software bisnis Anda memiliki performa terbaik, aman, dan siap bertumbuh.
        </p>
      </div>

      <!-- Partners Grid -->
      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          partners.map((partner) => (
            <div class="group relative flex flex-col justify-between rounded-2xl border border-gray-200 bg-white p-6 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950) dark:hover:border-blue-900/60">
              
              <div>
                <!-- Top Badge & Logo Row -->
                <div class="flex items-center justify-between gap-2 border-b border-gray-100 pb-5 dark:border-neutral-800">
                  <span class="inline-flex items-center rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700 dark:bg-neutral-800 dark:text-neutral-300">
                    {partner.badge}
                  </span>
                  <span class="text-xs font-medium text-gray-400 dark:text-neutral-500">
                    Partner Resmi
                  </span>
                </div>

                <!-- Logo Container -->
                <div class="flex h-20 items-center justify-center py-4">
                  <img
                    src={partner.logo}
                    alt={`Logo ${partner.name}`}
                    class="max-h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>

                <!-- Partner Info -->
                <div class="mt-3">
                  <div class="text-xs font-semibold tracking-wide text-blue-600 uppercase dark:text-blue-400">
                    {partner.category}
                  </div>
                  <h3 class="mt-1 text-xl font-bold text-gray-900 dark:text-white">
                    {partner.name}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
                    {partner.shortDesc}
                  </p>
                </div>

                <!-- Key Capabilities -->
                <div class="mt-5 space-y-2 border-t border-gray-100 pt-4 dark:border-neutral-800">
                  <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider dark:text-neutral-400">
                    Fokus Solusi Kriya:
                  </span>
                  <ul class="space-y-1.5 text-xs text-gray-600 dark:text-neutral-300">
                    {partner.capabilities.slice(0, 3).map((item: string) => (
                      <li class="flex items-start gap-2">
                        <svg class="mt-0.5 size-3.5 shrink-0 text-emerald-600 dark:text-emerald-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Action Link -->
              <div class="mt-7 pt-4 border-t border-gray-100 dark:border-neutral-800">
                <a
                  href={`/partners/${partner.slug}`}
                  class="inline-flex w-full items-center justify-center gap-x-2 rounded-xl bg-gray-50 px-4 py-2.5 text-sm font-semibold text-(--color-steel-blue-800) transition-all duration-200 hover:bg-(--color-steel-blue-800) hover:text-white dark:bg-neutral-800/80 dark:text-neutral-200 dark:hover:bg-(--color-steel-blue-700) dark:hover:text-white"
                >
                  Detail Solusi & Lisensi
                  <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>

            </div>
          ))
        }
      </div>

    </div>
  </section>

  <!-- Value Section: Why Choose Partner Solutions with Kriya -->
  <section class="bg-gray-50/80 py-16 dark:bg-(--color-deep-space-blue-950)/60 lg:py-20">
    <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
      
      <div class="mx-auto max-w-2xl text-center">
        <span class="inline-block rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold tracking-wider text-blue-700 uppercase dark:bg-blue-950/60 dark:text-blue-300">
          Nilai Tambah Kami
        </span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Mengapa Mengadopsi Solusi Mitra Melalui Kriya?
        </h2>
        <p class="mt-3 text-base text-gray-600 dark:text-neutral-400">
          Kami bukan sekadar reseller lisensi — Kriya adalah konsultan dan mitra implementasi teknis yang memastikan setiap investasi teknologi memberikan hasil maksimal bagi bisnis Anda.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Benefit 1 -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 transition-all hover:shadow-md dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
          <div class="flex size-12 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/50 dark:text-blue-400">
            <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-white">
            Lisensi Resmi & Transparan
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
            Akses langsung ke paket lisensi original dari prinsipal resmi dengan struktur biaya transparan dan faktur pajak lengkap di Indonesia.
          </p>
        </div>

        <!-- Benefit 2 -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 transition-all hover:shadow-md dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
          <div class="flex size-12 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400">
            <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.67 2.67 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.07a4.5 4.5 0 0 0 4.486-6.32l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.32 4.486c.118.58.094 1.193-.07 1.742m-.233 5.108a9.04 9.04 0 0 1-.416-.285" />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-white">
            Implementasi & Setup Terpandu
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
            Dikonfigurasi langsung oleh engineer profesional Kriya sesuai best practice keamanan arsitektur cloud dan efisiensi resource.
          </p>
        </div>

        <!-- Benefit 3 -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 transition-all hover:shadow-md dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
          <div class="flex size-12 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-400">
            <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-white">
            Migrasi Data Minim Downtime
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
            Kami merancang alur migrasi database, email, dan sistem aplikasi dengan downtime yang terkontrol ketat agar operasional bisnis tetap berjalan lancar.
          </p>
        </div>

        <!-- Benefit 4 -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 transition-all hover:shadow-md dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
          <div class="flex size-12 items-center justify-center rounded-lg bg-purple-50 text-purple-600 dark:bg-purple-950/50 dark:text-purple-400">
            <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-bold text-gray-900 dark:text-white">
            Support Teknis Lokal 24/7
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
            Dukungan purna-jual dan troubleshooting langsung dalam Bahasa Indonesia oleh tim teknis lokal dengan respon cepat dan SLA yang terjamin.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Process Section: 4 Simple Steps -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
      
      <div class="mx-auto max-w-2xl text-center">
        <span class="inline-block rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold tracking-wider text-blue-700 uppercase dark:bg-blue-950/60 dark:text-blue-300">
          Metodologi Kolaborasi
        </span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Tahapan Implementasi Solusi Mitra
        </h2>
        <p class="mt-3 text-base text-gray-600 dark:text-neutral-400">
          Alur kerja yang terstruktur dan teruji untuk memastikan adopsi teknologi berjalan tepat sasaran, hemat biaya, dan minim risiko.
        </p>
      </div>

      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Step 1 -->
        <div class="relative rounded-xl border border-gray-200 bg-white p-6 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
          <div class="text-3xl font-black text-blue-600/30 dark:text-blue-400/20">01</div>
          <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">Assessment & Konsultasi</h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">
            Sesi konsultasi mendalam untuk memahami alur kerja, beban sistem, dan rekomendasi paket partner yang paling efisien.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative rounded-xl border border-gray-200 bg-white p-6 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
          <div class="text-3xl font-black text-blue-600/30 dark:text-blue-400/20">02</div>
          <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">Roadmap & Pengadaan</h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">
            Penyusunan arsitektur sistem, jadwal deployment, serta aktivasi lisensi resmi dengan skema penagihan yang fleksibel.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="relative rounded-xl border border-gray-200 bg-white p-6 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
          <div class="text-3xl font-black text-blue-600/30 dark:text-blue-400/20">03</div>
          <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">Deployment & Migrasi</h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">
            Eksekusi instalasi teknis, transfer data aman, integrasi API sistem, dan pengujian performa menyeluruh sebelum go-live.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="relative rounded-xl border border-gray-200 bg-white p-6 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
          <div class="text-3xl font-black text-blue-600/30 dark:text-blue-400/20">04</div>
          <h3 class="mt-2 text-lg font-bold text-gray-900 dark:text-white">Training & Monitoring</h3>
          <p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">
            Pelatihan tim internal perusahaan serta monitoring performa berkelanjutan dengan dukungan teknis responsif 24/7.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA Section: Consultation -->
  <section class="bg-(--color-steel-blue-800) py-16 text-white dark:bg-(--color-steel-blue-950)">
    <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-white">
        Ingin Berkonsultasi Mengenai Solusi Mitra Kriya?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-blue-100">
        Diskusikan kebutuhan cloud hosting, lisensi software bisnis, atau migrasi infrastruktur Anda bersama konsultan spesialis Kriya secara gratis.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="https://wa.me/6285117428800?text=Halo%20Kriya,%20saya%20ingin%20konsultasi%20mengenai%20solusi%20kemitraan%20teknologi"
          class="inline-flex items-center gap-x-2 rounded-xl bg-white px-6 py-3.5 text-sm font-semibold text-gray-900 shadow-md transition-all hover:bg-gray-100 focus:outline-hidden"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="size-4 text-emerald-600" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"></path>
          </svg>
          Konsultasi Kemitraan via WhatsApp
        </a>
        <a
          href="/kontak"
          class="inline-flex items-center gap-x-2 rounded-xl border border-white/40 bg-transparent px-6 py-3.5 text-sm font-semibold text-white transition-all hover:bg-white/10 focus:outline-hidden"
        >
          Hubungi Tim Kriya
        </a>
      </div>
    </div>
  </section>

  <!-- RichSnippets -->
  <RichSnippets />
</BaseLayout>
