---
import BaseLayout from '@layouts/BaseLayout.astro';
import RichSnippets from '@components/RichSnippets.astro';
import { partners } from '@contents/partners/partners.mjs';
import { ChevronRight, Check, ArrowLeft, MessageCircle } from '@lucide/astro';

export function getStaticPaths() {
  return partners.map((partner) => {
    return {
      params: { slug: partner.slug },
      props: { partner },
    };
  });
}

const { partner } = Astro.props;

const pageTitle = `${partner.name} - Solusi & Kemitraan Strategis`;
const pageDesc = `Kolaborasi resmi PT. Alur Kriya Teknologi bersama ${partner.name}. ${partner.shortDesc}`;

const partnerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Solusi ${partner.name} oleh Kriya`,
  description: partner.description,
  provider: {
    '@type': 'Organization',
    name: 'PT. Alur Kriya Teknologi',
    url: 'https://kriya.click',
  },
  serviceType: partner.category,
};
---

<BaseLayout title={pageTitle} description={pageDesc} structuredData={partnerSchema}>
  <!-- Breadcrumb -->
  <div
    class="border-b border-gray-200 bg-white/50 py-4 backdrop-blur-xs dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)/50"
  >
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav
        class="flex items-center text-xs font-medium text-gray-500 dark:text-neutral-400"
        aria-label="Breadcrumb"
      >
        <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400">Beranda</a>
        <ChevronRight class="mx-2 size-3.5 text-gray-400" />
        <a href="/partners" class="hover:text-blue-600 dark:hover:text-blue-400">Kemitraan</a>
        <ChevronRight class="mx-2 size-3.5 text-gray-400" />
        <span class="font-semibold text-gray-900 dark:text-white">{partner.name}</span>
      </nav>
    </div>
  </div>

  <!-- Detail Content -->
  <section class="py-12 lg:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Partner Header Card -->
      <div
        class="rounded-3xl border border-gray-200 bg-white p-8 shadow-xs md:p-12 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)"
      >
        <div class="flex flex-col items-center text-center">
          <!-- Logo Display -->
          <div
            class="flex h-24 items-center justify-center rounded-2xl bg-gray-50/80 px-8 py-4 dark:bg-neutral-900/60"
          >
            <img
              src={partner.logo}
              alt={`Logo ${partner.name}`}
              class="max-h-16 w-auto object-contain"
              loading="eager"
            />
          </div>

          <!-- Badges -->
          <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
            <span
              class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300"
            >
              {partner.badge}
            </span>
            <span
              class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-neutral-800 dark:text-neutral-300"
            >
              {partner.category}
            </span>
          </div>

          <!-- Title -->
          <h1
            class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
          >
            {partner.name}
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-gray-600 dark:text-neutral-300">
            {partner.shortDesc}
          </p>
        </div>

        <!-- Divider -->
        <hr class="my-8 border-gray-100 dark:border-neutral-800" />

        <!-- Description -->
        <div>
          <h2 class="text-xl font-bold text-gray-900 dark:text-white">
            Tentang Kolaborasi Kemitraan
          </h2>
          <p class="mt-3 text-base leading-relaxed text-gray-700 dark:text-neutral-300">
            {partner.description}
          </p>
        </div>

        <!-- Capabilities Checklist -->
        <div class="mt-10 rounded-2xl bg-gray-50 p-6 dark:bg-neutral-900/50">
          <h3 class="text-base font-bold text-gray-900 dark:text-white">
            Cakupan Layanan & Kapabilitas Kriya:
          </h3>
          <ul class="mt-4 grid gap-3 sm:grid-cols-1 md:grid-cols-2">
            {
              partner.capabilities.map((cap: string) => (
                <li class="flex items-start gap-2.5 text-sm text-gray-700 dark:text-neutral-300">
                  <Check class="mt-0.5 size-4 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-400" />
                  <span>{cap}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Target Solusi -->
        {
          partner.targetSolutions && (
            <div class="mt-8 border-l-4 border-blue-600 py-1 pl-4 dark:border-blue-400">
              <h4 class="text-sm font-semibold tracking-wider text-gray-900 uppercase dark:text-white">
                Target Penggunaan Bisnis
              </h4>
              <p class="mt-1 text-sm text-gray-600 dark:text-neutral-400">
                {partner.targetSolutions}
              </p>
            </div>
          )
        }

        <!-- Action CTAs -->
        <div
          class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-gray-100 pt-6 dark:border-neutral-800"
        >
          <a
            href="/partners"
            class="inline-flex items-center gap-x-2 text-sm font-semibold text-gray-600 transition-colors hover:text-blue-600 dark:text-neutral-400 dark:hover:text-blue-400"
          >
            <ArrowLeft class="size-4 shrink-0" />
            Kembali ke Daftar Kemitraan
          </a>

          <a
            href={`https://wa.me/6285117428800?text=Halo%20Kriya,%20saya%20ingin%20konsultasi%20solusi%20kemitraan%20${encodeURIComponent(partner.name)}`}
            class="inline-flex items-center gap-x-2 rounded-xl bg-(--color-steel-blue-800) px-5 py-3 text-sm font-semibold text-white shadow-md transition-all hover:bg-(--color-steel-blue-700) focus:outline-hidden dark:bg-(--color-steel-blue-700) dark:hover:bg-(--color-steel-blue-600)"
            target="_blank"
            rel="noopener noreferrer"
          >
            <MessageCircle class="size-4 text-emerald-400" />
            Konsultasi Solusi {partner.name}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- RichSnippets -->
  <RichSnippets />
</BaseLayout>
