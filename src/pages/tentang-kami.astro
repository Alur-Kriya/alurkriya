---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroBanner from '@components/pages/HeroBanner.astro';
import { pages } from '@contents/pages/pages.mjs';
import { Image } from 'astro:assets';
import imgAbout from '@images/img-a.png';

const content = pages.find((item: any) => item.slug === 'tentang-kami');

if (!content) {
  throw new Error('Page with slug "tentang-kami" not found');
}
---

<BaseLayout title={content.title} description={content.desc}>
  <HeroBanner heading={content.heading} description={content.desc} />

  <!-- Profil Perusahaan -->
  <section class="about-section">
    <div class="about-container">
      <div class="about-grid">
        <div class="about-image-col">
          <Image
            src={imgAbout}
            alt="PT Alur Kriya Teknologi"
            class="about-image"
            draggable="false"
            loading="lazy"
            format="avif"
          />
        </div>
        <div class="about-text-col">
          <span class="about-label">Tentang Perusahaan</span>
          <h2 class="about-title">PT. Alur Kriya Teknologi</h2>
          <div class="about-body">
            <p>
              PT. Alur Kriya Teknologi <strong>(Kriya)</strong> adalah perusahaan teknologi informasi yang berfokus
              pada penyediaan solusi digital terintegrasi untuk membantu perusahaan meningkatkan efisiensi
              operasional, memperkuat infrastruktur teknologi, dan mendukung transformasi digital yang berkelanjutan.
            </p>
            <p>
              Perusahaan hadir sebagai <strong>mitra strategis</strong> yang mendampingi klien dalam merancang,
              membangun, mengelola, serta mengoptimalkan berbagai kebutuhan teknologi informasi.
            </p>
            <p>
              Dengan pendekatan yang berorientasi pada kebutuhan bisnis, Kriya tidak hanya menghadirkan solusi yang
              unggul secara teknis, tetapi juga memastikan setiap implementasi mampu memberikan nilai tambah yang
              nyata bagi pertumbuhan perusahaan.
            </p>
            <p>
              Melalui pengelolaan sistem yang <strong>proaktif dan preventif</strong>, Kriya membantu meminimalkan
              risiko operasional, meningkatkan keamanan sistem, serta menjaga keberlangsungan bisnis klien.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visi & Misi -->
  <section class="vismis-section">
    <div class="about-container">
      <div class="vismis-header">
        <span class="about-label">Arah & Tujuan</span>
        <h2 class="about-title">Visi &amp; Misi</h2>
      </div>

      <div class="vismis-grid">
        <!-- Visi -->
        <div class="vismis-card vismis-card--visi">
          <div class="vismis-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          </div>
          <h3 class="vismis-title">Visi</h3>
          <p class="vismis-body">
            Menjadi mitra transformasi digital terpercaya bagi perusahaan di Indonesia — menghadirkan
            solusi teknologi yang inovatif, andal, dan berdampak nyata bagi pertumbuhan bisnis setiap klien.
          </p>
        </div>

        <!-- Misi -->
        <div class="vismis-card vismis-card--misi">
          <div class="vismis-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"></path><path d="M12 8v4l3 3"></path></svg>
          </div>
          <h3 class="vismis-title">Misi</h3>
          <ul class="vismis-list">
            <li>Menyediakan layanan IT terintegrasi yang mendukung efisiensi dan pertumbuhan bisnis klien.</li>
            <li>Membangun infrastruktur teknologi yang aman, skalabel, dan siap menghadapi tantangan masa depan.</li>
            <li>Mendampingi klien secara proaktif dalam mengelola, memantau, dan mengoptimalkan sistem teknologi mereka.</li>
            <li>Menjalin kemitraan jangka panjang yang dilandasi kepercayaan, transparansi, dan komitmen terhadap kualitas.</li>
            <li>Terus berinovasi dan mengadopsi teknologi terkini demi memberikan solusi terbaik bagi setiap kebutuhan bisnis.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Nilai-Nilai Perusahaan -->
  <section class="values-section">
    <div class="about-container">
      <div class="vismis-header">
        <span class="about-label">Fondasi Kami</span>
        <h2 class="about-title">Nilai-Nilai Perusahaan</h2>
      </div>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <h4 class="value-title">Kepercayaan</h4>
          <p class="value-body">Kami membangun hubungan jangka panjang berdasarkan transparansi, kejujuran, dan integritas dalam setiap interaksi dengan klien.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
          </div>
          <h4 class="value-title">Kualitas</h4>
          <p class="value-body">Setiap solusi yang kami hadirkan dirancang dengan standar teknis tinggi, diuji secara menyeluruh, dan berorientasi pada hasil yang optimal.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
          </div>
          <h4 class="value-title">Inovasi</h4>
          <p class="value-body">Kami senantiasa mengikuti perkembangan teknologi terkini dan berani berinovasi untuk menghadirkan solusi yang relevan dan kompetitif.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h4 class="value-title">Kemitraan</h4>
          <p class="value-body">Kami percaya bahwa kesuksesan klien adalah kesuksesan kami. Kami hadir bukan sekadar vendor, melainkan sebagai mitra strategis bisnis Anda.</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Layout ── */
  .about-section {
    padding: 4rem 0;
  }

  .vismis-section {
    padding: 4rem 0;
    background-color: #f9fafb;
  }

  :global(.dark) .vismis-section {
    background-color: #111827;
  }

  .values-section {
    padding: 4rem 0;
  }

  .about-container {
    max-width: 85rem;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  @media (min-width: 640px) {
    .about-container {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .about-container {
      padding-left: 2rem;
      padding-right: 2rem;
    }
    .about-section, .vismis-section, .values-section {
      padding: 5rem 0;
    }
  }

  /* ── About Grid ── */
  .about-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .about-image {
    width: 100%;
    border-radius: 1rem;
    object-fit: cover;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }

  .about-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2563eb;
    margin-bottom: 0.5rem;
  }

  :global(.dark) .about-label {
    color: #60a5fa;
  }

  .about-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: #111827;
    line-height: 1.25;
    margin-bottom: 1.5rem;
  }

  :global(.dark) .about-title {
    color: #f9fafb;
  }

  .about-body p {
    color: #4b5563;
    line-height: 1.75;
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  :global(.dark) .about-body p {
    color: #d1d5db;
  }

  .about-body strong {
    color: #111827;
    font-weight: 600;
  }

  :global(.dark) .about-body strong {
    color: #f9fafb;
  }

  /* ── Visi & Misi ── */
  .vismis-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .vismis-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .vismis-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .vismis-card {
    border-radius: 1rem;
    padding: 2rem;
    border: 1px solid #e5e7eb;
    background-color: #ffffff;
  }

  :global(.dark) .vismis-card {
    background-color: #1f2937;
    border-color: #374151;
  }

  .vismis-card--visi {
    border-top: 4px solid #2563eb;
  }

  .vismis-card--misi {
    border-top: 4px solid #059669;
  }

  .vismis-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    background-color: #eff6ff;
    color: #2563eb;
    margin-bottom: 1rem;
  }

  :global(.dark) .vismis-icon {
    background-color: #1e3a5f;
    color: #60a5fa;
  }

  .vismis-card--misi .vismis-icon {
    background-color: #ecfdf5;
    color: #059669;
  }

  :global(.dark) .vismis-card--misi .vismis-icon {
    background-color: #064e3b;
    color: #34d399;
  }

  .vismis-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.75rem;
  }

  :global(.dark) .vismis-title {
    color: #f9fafb;
  }

  .vismis-body {
    color: #4b5563;
    line-height: 1.75;
  }

  :global(.dark) .vismis-body {
    color: #d1d5db;
  }

  .vismis-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .vismis-list li {
    display: flex;
    gap: 0.625rem;
    color: #4b5563;
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  :global(.dark) .vismis-list li {
    color: #d1d5db;
  }

  .vismis-list li::before {
    content: '✓';
    color: #059669;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  :global(.dark) .vismis-list li::before {
    color: #34d399;
  }

  /* ── Nilai-Nilai ── */
  .values-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .values-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .values-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .value-card {
    padding: 1.75rem;
    border-radius: 1rem;
    border: 1px solid #e5e7eb;
    background-color: #ffffff;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .value-card:hover {
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }

  :global(.dark) .value-card {
    background-color: #1f2937;
    border-color: #374151;
  }

  :global(.dark) .value-card:hover {
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .value-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.625rem;
    background-color: #eff6ff;
    color: #2563eb;
    margin-bottom: 1rem;
  }

  :global(.dark) .value-icon {
    background-color: #1e3a5f;
    color: #60a5fa;
  }

  .value-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  :global(.dark) .value-title {
    color: #f9fafb;
  }

  .value-body {
    font-size: 0.9375rem;
    color: #6b7280;
    line-height: 1.65;
  }

  :global(.dark) .value-body {
    color: #9ca3af;
  }
</style>
