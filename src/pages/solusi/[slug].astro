---
import BaseLayout from '@layouts/BaseLayout.astro';
import RichSnippets from '@components/RichSnippets.astro';
import Faq from '@components/services/Faq.astro';
import SolutionHero from '@components/solutions/SolutionHero.astro';
import ClientLogos from '@components/solutions/ClientLogos.astro';
import PainPoints from '@components/solutions/PainPoints.astro';
import RootCause from '@components/solutions/RootCause.astro';
import ComparisonTable from '@components/solutions/ComparisonTable.astro';
import PainSolution from '@components/solutions/PainSolution.astro';
import RoleBenefits from '@components/solutions/RoleBenefits.astro';
import ModuleExplorer from '@components/solutions/ModuleExplorer.astro';
import ComplianceSection from '@components/solutions/ComplianceSection.astro';
import SolutionTestimonials from '@components/solutions/SolutionTestimonials.astro';
import SolutionCta from '@components/solutions/SolutionCta.astro';
import NetworkSegmentCards from '@components/solutions/NetworkSegmentCards.astro';
import HardwareEcosystem from '@components/solutions/HardwareEcosystem.astro';
import ImplementationWorkflow from '@components/solutions/ImplementationWorkflow.astro';
import { solutions } from '@contents/solutions/solutions.mjs';
import { SEOS } from '@lib/seos';

export function getStaticPaths() {
  return solutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

const { solution } = Astro.props;

if (!solution) {
  throw new Error('Solution data not found');
}

const pageTitle = solution.title;
const pageDesc = solution.description;

// Structured data schema: Service for Network Infrastructure or SoftwareApplication for ERP
const isService = solution.schemaType === 'Service' || !solution.compliance;

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: SEOS.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Solusi',
      item: `${SEOS.url}/solusi`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: solution.name,
      item: `${SEOS.url}/solusi/${solution.slug}`,
    },
  ],
};

const structuredData = isService
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Service',
          '@id': `${SEOS.url}/solusi/${solution.slug}#service`,
          name: solution.name,
          alternateName: solution.title,
          description: solution.description,
          serviceType: solution.category,
          provider: {
            '@type': 'Organization',
            name: SEOS.legalName,
            alternateName: SEOS.name,
            url: SEOS.url,
            logo: `${SEOS.url}/favicon.svg`,
            telephone: SEOS.phone,
            email: SEOS.email,
          },
          areaServed: 'ID',
          hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: solution.name,
            itemListElement: solution.modules.map(
              (m: { title: string; summary: string }, idx: number) => ({
                '@type': 'Offer',
                position: idx + 1,
                itemOffered: {
                  '@type': 'Service',
                  name: m.title,
                  description: m.summary,
                },
              })
            ),
          },
        },
        breadcrumbs,
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: solution.name,
      alternateName: 'Sistem ERP Lembaga Amil Zakat Kriya',
      description: solution.description,
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'Enterprise Resource Planning (ERP)',
      operatingSystem: 'Web-based Cloud ERP',
      url: `${SEOS.url}/solusi/${solution.slug}`,
      provider: {
        '@type': 'Organization',
        name: SEOS.legalName,
        alternateName: SEOS.name,
        url: SEOS.url,
        logo: `${SEOS.url}/favicon.svg`,
        telephone: SEOS.phone,
        email: SEOS.email,
      },
      featureList: solution.modules.map((m: { title: string }) => m.title),
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'IDR',
        description: 'Sesi konsultasi kebutuhan dan demonstrasi sistem gratis via WhatsApp.',
      },
    };
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  ogimage={solution.ogimage}
  url={`${SEOS.url}/solusi/${solution.slug}`}
  structuredData={structuredData}
>
  <!-- 1. Hero Section & Primary CTA -->
  <SolutionHero
    eyebrow={solution.hero?.eyebrow || solution.badge}
    heading={solution.name}
    headline={solution.hero?.headline}
    description={solution.description}
    subheadline={solution.hero?.subheadline}
    waMessage={solution.waMessage}
    primaryCtaText={solution.hero?.primaryCta}
    secondaryCtaText={solution.hero?.secondaryCta}
    secondaryCtaHref={solution.hero?.secondaryCtaHref || '#cara-kerja'}
    image={solution.images?.hero}
    imageAlt={solution.name}
  />

  <!-- 2. Masalah Jaringan yang Kami Tangani -->
  <PainPoints
    title={solution.painPointsTitle}
    subtitle={solution.painPointsSubtitle}
    painPoints={solution.painPoints}
  />

  <!-- 3. Solusi Jaringan Berdasarkan Kebutuhan Bangunan -->
  {solution.segments && <NetworkSegmentCards segments={solution.segments} />}

  <!-- Analisis Akar Masalah & Komparasi Teknis -->
  <RootCause rootCause={solution.rootCause} />

  <ComparisonTable comparison={solution.comparison} />

  <PainSolution
    heading={solution.deepDivesHeading}
    subheading={solution.deepDivesSubheading}
    deepDives={solution.deepDives}
  />

  <!-- Simulasi Pemantauan Jaringan / Manfaat Berbasis Peran -->
  {
    solution.roles && (
      <RoleBenefits
        headline={solution.rolesHeading}
        subheadline={solution.rolesSubheading}
        roles={solution.roles}
      />
    )
  }

  <!-- 4. Lingkup Pekerjaan Rekayasa Jaringan -->
  <ModuleExplorer
    badge={solution.modulesBadge}
    title={solution.modulesTitle}
    subtitle={solution.modulesSubtitle}
    modules={solution.modules}
  />

  <!-- Keamanan & Kepatuhan Regulasi (Hanya Solusi ERP) -->
  {solution.compliance && <ComplianceSection />}

  <!-- 5. Teknologi dan Perangkat yang Digunakan (Hardware Ecosystem) -->
  {solution.hardwareEcosystem && <HardwareEcosystem hardware={solution.hardwareEcosystem} />}

  <!-- 6. Tahapan Implementasi Instalasi (Alur Network Service) -->
  {
    solution.implementationSteps && isService && (
      <ImplementationWorkflow
        id="proses-instalasi"
        headline={solution.customizationHeadline}
        subheadline={solution.customizationSubheadline}
        steps={solution.implementationSteps}
        waMessage={solution.waMessage}
      />
    )
  }

  <!-- 7. Standar Pengujian dan Dokumentasi Hasil Pekerjaan -->
  <SolutionTestimonials
    title={solution.impactHeading}
    subtitle={solution.impactSubheading}
    highlights={solution.impactHighlights}
    testimonials={solution.testimonials}
  />

  <!-- 8. Tipe Bangunan yang Didukung / Bukti Implementasi -->
  {
    solution.clientInstitutions && (
      <ClientLogos heading={solution.trustBannerHeading} clients={solution.clientInstitutions} />
    )
  }

  <!-- Tahapan Implementasi (Alur Solusi Non-Service / ERP) -->
  {
    solution.implementationSteps && !isService && (
      <ImplementationWorkflow
        headline={solution.customizationHeadline}
        subheadline={solution.customizationSubheadline}
        steps={solution.implementationSteps}
        waMessage={solution.waMessage}
      />
    )
  }

  <!-- 9. FAQ Section -->
  <Faq
    title={solution.faqHeading || 'Pertanyaan yang Sering Diajukan'}
    heading={solution.name}
    subheading={solution.faqSubheading ||
      `Pertanyaan umum seputar instalasi, cakupan, dan operasional ${solution.name}.`}
    faqs={solution.faqs}
    q1={solution.faqs[0]?.q || ''}
    a1={solution.faqs[0]?.a || ''}
    q2={solution.faqs[1]?.q || ''}
    a2={solution.faqs[1]?.a || ''}
    q3={solution.faqs[2]?.q || ''}
    a3={solution.faqs[2]?.a || ''}
    q4={solution.faqs[3]?.q || ''}
    a4={solution.faqs[3]?.a || ''}
    q5={solution.faqs[4]?.q || ''}
    a5={solution.faqs[4]?.a || ''}
    q6={solution.faqs[5]?.q || ''}
    a6={solution.faqs[5]?.a || ''}
  />

  <!-- 10. High-Conversion Closing CTA -->
  <SolutionCta
    title={solution.ctaTitle || 'Siap Membangun Jaringan Wi-Fi yang Andal?'}
    desc={solution.ctaDesc ||
      'Konsultasikan kebutuhan instalasi dan perluasan jaringan bangunan Anda bersama tim Kriya.'}
    message={solution.waMessage}
    ctaLabel={solution.ctaButtonLabel}
    note={solution.ctaNote}
  />

  <RichSnippets />
</BaseLayout>
