---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroBanner from '@components/pages/HeroBanner.astro';
import { pages } from '@contents/pages/pages.mjs';
import { MessageSquare, Quote, Building2 } from '@lucide/astro';

const slug = 'testimoni';
const content = pages.find((item: any) => item.slug === slug);

if (!content) {
  throw new Error(`Page with slug "${slug}" not found`);
}

const verifiedPartners = [
  {
    name: 'PT. Mondelēz Indonesia Manufacturing',
    pic: 'Miduk Lasman',
    initials: 'ML',
    role: 'Project Engineer & Automation Lead',
    quote:
      'Tim Kriya sangat responsif, jelas dalam menjelaskan solusi yang ditawarkan, serta fleksibel dalam penjadwalan sesuai dengan kebutuhan operasional pabrik kami.',
  },
];
---

<BaseLayout title={content.title} description={content.desc}>
  <HeroBanner heading={content.heading} description={content.desc} />

  <!-- Testimonials Content -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
          Ulasan &amp; Pengalaman Mitra
        </h2>
        <p class="mt-4 text-base text-gray-600 dark:text-neutral-400">
          Ulasan nyata dari pimpinan proyek dan mitra yang telah berkolaborasi bersama Kriya dalam
          implementasi teknologi.
        </p>
      </div>

      <!-- Verified Testimonials List -->
      <div class="space-y-8">
        {
          verifiedPartners.map((item) => (
            <div class="relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-8 shadow-xs sm:p-10 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
              <Quote
                class="absolute end-6 top-6 size-16 text-gray-100 dark:text-neutral-800/60"
                aria-hidden="true"
              />

              <div class="relative z-10 flex flex-col gap-6 sm:flex-row sm:items-center">
                <div class="shrink-0">
                  <div class="flex size-16 items-center justify-center rounded-full bg-(--color-steel-blue-100) text-xl font-bold text-(--color-steel-blue-800) ring-4 ring-emerald-50 dark:bg-(--color-steel-blue-900) dark:text-(--color-steel-blue-200) dark:ring-neutral-800">
                    {item.initials}
                  </div>
                </div>

                <div class="grow">
                  <blockquote class="text-base text-gray-700 italic sm:text-lg dark:text-neutral-200">
                    "{item.quote}"
                  </blockquote>

                  <div class="mt-4">
                    <div class="font-bold text-gray-900 dark:text-white">{item.pic}</div>
                    <div class="text-xs font-medium text-emerald-700 dark:text-emerald-400">
                      {item.role}
                    </div>
                    <div class="mt-0.5 flex items-center gap-1.5 text-xs text-gray-500 dark:text-neutral-400">
                      <Building2 class="size-3.5" />
                      <span>{item.name}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Honest Invitation -->
      <div
        class="mt-14 rounded-2xl border border-dashed border-gray-300 bg-gray-50/70 p-8 text-center dark:border-neutral-700 dark:bg-neutral-900/30"
      >
        <div
          class="mx-auto flex size-12 items-center justify-center rounded-xl bg-(--color-steel-blue-50) text-(--color-steel-blue-700) dark:bg-neutral-800 dark:text-(--color-steel-blue-300)"
        >
          <MessageSquare class="size-6" />
        </div>
        <h3 class="mt-4 text-lg font-bold text-gray-900 dark:text-white">
          Apakah Perusahaan Anda Pernah Bekerja Sama dengan Kriya?
        </h3>
        <p class="mx-auto mt-2 max-w-lg text-sm text-gray-600 dark:text-neutral-400">
          Ulasan dan masukan Anda sangat berharga bagi kami untuk terus menyempurnakan kualitas
          layanan dan keandalan sistem.
        </p>
        <div class="mt-6">
          <a
            href="/kontak"
            class="inline-flex min-h-[44px] items-center justify-center rounded-xl bg-(--color-steel-blue-800) px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-(--color-steel-blue-700) focus:outline-hidden focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-400) focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-900"
          >
            Kirimkan Masukan &amp; Ulasan
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
