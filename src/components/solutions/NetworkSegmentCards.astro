---
import {
  Building2,
  House,
  CheckCircle2,
  ArrowRight,
  Wifi,
  Network,
  ShieldCheck,
  Zap,
  Activity,
  Layers,
  Router,
} from '@lucide/astro';
import { getWaUrl } from '@lib/whatsapp';

interface SegmentItem {
  id: string;
  badge: string;
  title: string;
  targetSpaces: string[];
  description: string;
  priorities: Array<{
    title: string;
    desc: string;
  }>;
  specs: Array<{
    label: string;
    value: string;
  }>;
  waMessage: string;
}

interface Props {
  segments?: SegmentItem[];
}

const defaultSegments: SegmentItem[] = [
  {
    id: 'sme-commercial',
    badge: 'Segmen Komersial & UKM',
    title: 'Perkantoran, Ruko Bertingkat, Gudang & Workshop',
    targetSpaces: ['Kantor 1-3 Lantai', 'Ruko Bisnis', 'Gudang Logistik', 'Kafe & Resto'],
    description:
      'Fokus pada ketersediaan koneksi tanpa henti, kapasitas multi-user bersamaan, dan pembagian jalur prioritas untuk operasional bisnis kritis.',
    priorities: [
      {
        title: 'Prioritas Bandwidth Kasir & Cloud ERP (QoS)',
        desc: 'Sistem POS kasir, transaksi pembayaran, dan akses database kantor tetap lancar meskipun staf lain sedang streaming atau unduh berkas besar.',
      },
      {
        title: 'Isolasi Jaringan Tamu (VLAN Guest)',
        desc: 'Pengunjung mendapatkan akses Wi-Fi cepat tanpa bisa melihat atau mengakses server lokal, NAS, printer kantor, dan komputer internal.',
      },
      {
        title: 'Penetrasi Sinyal Dinding Tebal & Gudang',
        desc: 'Penempatan Access Point strategis dan directional antena untuk menjangkau area berpartisi bata tebal, beton, dan rak besi gudang.',
      },
      {
        title: 'Kapasitas Concurrency Tinggi',
        desc: 'Perangkat enterprise siap melayani 40 hingga 100+ koneksi gawai sekaligus tanpa overheat, latency melonjak, atau router hang.',
      },
    ],
    specs: [
      { label: 'Topologi', value: 'Backbone Cat6 PoE Gigabit + Managed Switch' },
      { label: 'Konektivitas', value: 'Multi-SSID dengan VLAN Tagging 802.1Q' },
      { label: 'Manajemen', value: 'Traffic Shaper / Dynamic QoS Prioritization' },
    ],
    waMessage:
      'Halo Kriya, saya ingin konsultasi kebutuhan perluasan jaringan internet untuk kantor / ruko UKM kami.',
  },
  {
    id: 'residential-property',
    badge: 'Segmen Residensial & Hunian',
    title: 'Rumah Bertingkat 2-4 Lantai, Klaster & Villa',
    targetSpaces: ['Rumah 2-4 Lantai', 'Klaster Hunian', 'Villa & Paviliun', 'Home Office / WFH'],
    description:
      'Mengutamakan estetika interior rumah tanpa kabel berseliweran, roaming mulus saat berpindah lantai, dan latensi rendah untuk hiburan keluarga.',
    priorities: [
      {
        title: 'Seamless Roaming Tanpa Putus (802.11k/v/r)',
        desc: 'Pindah dari ruang tamu lantai 1 ke kamar tidur lantai 2 atau 3 tanpa panggilan video WhatsApp drop atau tayangan video terhenti.',
      },
      {
        title: 'Instalasi Kabel Rapi & Tersembunyi',
        desc: 'Jalur kabel Cat6 ditanam rapi melalui conduit pipa, celah plafon, atau pelindung kabel dekoratif yang menyatu dengan estetika interior.',
      },
      {
        title: 'Koneksi Stabil untuk Smart Home & CCTV Outdoor',
        desc: 'Kamera CCTV gerbang, smart lock, lampu pintar, dan speaker IoT tetap terhubung stabil tanpa berebut bandwidth dengan TV 4K.',
      },
      {
        title: 'Parental Control & Jadwal Internet',
        desc: 'Pengaturan pembatasan konten berbahaya dan jadwal matikan akses internet malam hari untuk perangkat gawai anak-anak.',
      },
    ],
    specs: [
      { label: 'Jangkauan', value: 'Cakupan Merata Lantai 1 hingga Rooftop' },
      { label: 'Protokol', value: 'Wi-Fi 6 (802.11ax) Dual-Band Seamless Roaming' },
      { label: 'Estetika', value: 'Concealed Cable Routing & Sleek Ceiling AP' },
    ],
    waMessage:
      'Halo Kriya, saya ingin konsultasi perbaikan jangkauan Wi-Fi dan instalasi jaringan untuk rumah bertingkat kami.',
  },
];

const { segments = defaultSegments } = Astro.props;
---

<section id="segmen-solusi" class="scroll-mt-20 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3.5 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300"
      >
        <Layers class="size-3.5 text-emerald-600 dark:text-emerald-400" />
        Spesifikasi Sesuai Tipe Kebutuhan
      </span>
      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
      >
        Dirancang Spesifik untuk Tantangan Arsitektur Bangunan Anda
      </h2>
      <p class="mt-4 text-base text-gray-600 sm:text-lg dark:text-neutral-300">
        Kebutuhan stabilitas jaringan kantor bisnis berbeda dengan kenyamanan hunian keluarga. Kami
        menyesuaikan topologi kabel, konfigurasi router, dan tipe access point sesuai peruntukan
        ruang.
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-2">
      {
        segments.map((seg, idx) => {
          const isCommercial = seg.id === 'sme-commercial' || idx === 0;

          return (
            <div class="flex flex-col justify-between overflow-hidden rounded-3xl border border-gray-200/90 bg-white p-6 shadow-xs transition-all duration-300 hover:border-emerald-500/50 hover:shadow-xl sm:p-8 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
              <div>
                <!-- Header Badge & Target Spaces -->
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 pb-5 dark:border-neutral-800">
                  <span class="inline-flex items-center gap-2 rounded-xl bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
                    {isCommercial ? (
                      <Building2 class="size-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                    ) : (
                      <House class="size-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                    )}
                    {seg.badge}
                  </span>

                  <div class="flex flex-wrap gap-1.5">
                    {seg.targetSpaces.map((space) => (
                      <span class="rounded-md bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600 dark:bg-neutral-800 dark:text-neutral-300">
                        {space}
                      </span>
                    ))}
                  </div>
                </div>

                <h3 class="mt-5 text-xl font-extrabold tracking-tight text-gray-900 sm:text-2xl dark:text-white">
                  {seg.title}
                </h3>

                <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-neutral-300">
                  {seg.description}
                </p>

                <!-- Visual Network Architecture Topology Diagram -->
                <div class="mt-6 rounded-2xl border border-gray-200/80 bg-linear-to-b from-gray-50/90 to-gray-100/40 p-4 dark:border-neutral-800 dark:from-neutral-900/80 dark:to-(--color-deep-space-blue-900)/40">
                  <div class="flex items-center justify-between border-b border-gray-200/60 pb-2.5 dark:border-neutral-800">
                    <span class="flex items-center gap-1.5 text-[11px] font-bold tracking-wider text-gray-600 uppercase dark:text-neutral-300">
                      <Network class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                      Visual Arsitektur Topologi Alur Kriya
                    </span>
                    <span class="rounded-md bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300">
                      Gigabit PoE Full-Duplex
                    </span>
                  </div>

                  <!-- Topology Flowchart Nodes -->
                  <div class="mt-3 grid grid-cols-1 gap-2 text-xs sm:grid-cols-3">
                    {isCommercial ? (
                      <>
                        <div class="rounded-xl border border-gray-200 bg-white p-2.5 text-center shadow-2xs dark:border-neutral-700 dark:bg-neutral-800">
                          <p class="text-[10px] font-bold text-gray-400 uppercase">Input</p>
                          <p class="mt-0.5 font-bold text-gray-900 dark:text-white">Modem Fiber ISP</p>
                          <p class="text-[10px] text-emerald-600 dark:text-emerald-400">Multi-WAN Ready</p>
                        </div>
                        <div class="rounded-xl border border-emerald-300/80 bg-emerald-50/50 p-2.5 text-center shadow-2xs dark:border-emerald-800/80 dark:bg-emerald-950/30">
                          <p class="text-[10px] font-bold text-emerald-700 uppercase dark:text-emerald-300">Core Engine</p>
                          <p class="mt-0.5 font-bold text-gray-900 dark:text-white">MikroTik Router</p>
                          <p class="text-[10px] font-medium text-gray-600 dark:text-neutral-300">Traffic QoS + VLAN</p>
                        </div>
                        <div class="rounded-xl border border-gray-200 bg-white p-2.5 text-center shadow-2xs dark:border-neutral-700 dark:bg-neutral-800">
                          <p class="text-[10px] font-bold text-gray-400 uppercase">Distribusi</p>
                          <p class="mt-0.5 font-bold text-gray-900 dark:text-white">Wi-Fi 6 AP & CCTV</p>
                          <p class="text-[10px] text-emerald-600 dark:text-emerald-400">PoE Gigabit Switch</p>
                        </div>
                      </>
                    ) : (
                      <>
                        <div class="rounded-xl border border-gray-200 bg-white p-2.5 text-center shadow-2xs dark:border-neutral-700 dark:bg-neutral-800">
                          <p class="text-[10px] font-bold text-gray-400 uppercase">Input Utama</p>
                          <p class="mt-0.5 font-bold text-gray-900 dark:text-white">Fiber Terminal</p>
                          <p class="text-[10px] text-emerald-600 dark:text-emerald-400">Pusat Kabel Panel</p>
                        </div>
                        <div class="rounded-xl border border-emerald-300/80 bg-emerald-50/50 p-2.5 text-center shadow-2xs dark:border-emerald-800/80 dark:bg-emerald-950/30">
                          <p class="text-[10px] font-bold text-emerald-700 uppercase dark:text-emerald-300">Backbone</p>
                          <p class="mt-0.5 font-bold text-gray-900 dark:text-white">Cat6 In-Wall Conduit</p>
                          <p class="text-[10px] font-medium text-gray-600 dark:text-neutral-300">Kabel Rapi Tersembunyi</p>
                        </div>
                        <div class="rounded-xl border border-gray-200 bg-white p-2.5 text-center shadow-2xs dark:border-neutral-700 dark:bg-neutral-800">
                          <p class="text-[10px] font-bold text-gray-400 uppercase">Cakupan</p>
                          <p class="mt-0.5 font-bold text-gray-900 dark:text-white">AP Lantai 1, 2, 3</p>
                          <p class="text-[10px] text-emerald-600 dark:text-emerald-400">Fast Roaming &lt;50ms</p>
                        </div>
                      </>
                    )}
                  </div>
                </div>

                <!-- Priorities List -->
                <div class="mt-6 space-y-3.5">
                  <h4 class="text-xs font-bold tracking-wider text-gray-500 uppercase dark:text-neutral-400">
                    Fokus Rekayasa Teknis:
                  </h4>
                  {seg.priorities.map((item) => (
                    <div class="flex items-start gap-3 rounded-2xl border border-gray-100 bg-gray-50/60 p-3.5 transition-colors hover:bg-gray-50 dark:border-neutral-800 dark:bg-neutral-900/50 dark:hover:bg-neutral-900/80">
                      <CheckCircle2 class="mt-0.5 size-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                      <div>
                        <h5 class="text-xs font-bold text-gray-900 dark:text-white">{item.title}</h5>
                        <p class="mt-1 text-xs leading-relaxed text-gray-600 dark:text-neutral-400">
                          {item.desc}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>

                <!-- Technical Standard Specs -->
                <div class="mt-6 rounded-2xl border border-emerald-100 bg-emerald-50/40 p-4 dark:border-emerald-900/30 dark:bg-emerald-950/20">
                  <span class="block text-[11px] font-bold tracking-wider text-emerald-800 uppercase dark:text-emerald-300">
                    Standar Implementasi:
                  </span>
                  <dl class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-3">
                    {seg.specs.map((spec) => (
                      <div class="border-t border-emerald-200/50 pt-1.5 sm:border-t-0 sm:border-l sm:pl-2.5 sm:first:border-l-0 sm:first:pl-0 dark:border-emerald-800/40">
                        <dt class="text-[10px] font-semibold text-gray-500 dark:text-neutral-400">
                          {spec.label}
                        </dt>
                        <dd class="mt-0.5 text-xs font-bold text-gray-900 dark:text-white">
                          {spec.value}
                        </dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </div>

              <!-- Button CTA -->
              <div class="mt-8 border-t border-gray-100 pt-6 dark:border-neutral-800">
                <a
                  href={getWaUrl(seg.waMessage)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-[44px] w-full items-center justify-center gap-x-2 rounded-xl bg-(--color-steel-blue-800) px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-(--color-steel-blue-700) focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:ring-offset-2 focus-visible:outline-hidden dark:bg-(--color-steel-blue-700) dark:hover:bg-(--color-steel-blue-600) dark:focus-visible:ring-offset-neutral-900"
                >
                  <span>Konsultasikan Kebutuhan {isCommercial ? 'UKM' : 'Rumah'} via WA</span>
                  <ArrowRight class="size-4 shrink-0" />
                </a>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

