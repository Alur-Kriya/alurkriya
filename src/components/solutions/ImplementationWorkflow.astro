---
import { CheckCircle2, ArrowRight, ShieldCheck, Headphones } from '@lucide/astro';
import { getWaUrl } from '@lib/whatsapp';

interface Props {
  badge?: string;
  headline?: string;
  subheadline?: string;
  steps: Array<{
    step: string;
    title: string;
    desc: string;
  }>;
  waMessage?: string;
  ctaLabel?: string;
}

const {
  badge = 'Metodologi Implementasi Teruji',
  headline = 'Tahapan Implementasi Sistem dari Awal hingga Operasional Mandiri',
  subheadline = 'Kami tidak sekadar memberikan software, melainkan mendampingi adaptasi sistem, migrasi data historis, hingga seluruh amil siap operasional 100%.',
  steps = [],
  waMessage = 'Halo Kriya, saya ingin konsultasi mengenai tahapan implementasi Software ZISWAF ERP untuk lembaga kami.',
  ctaLabel = 'Konsultasikan Jadwal Implementasi',
} = Astro.props;

const waUrl = getWaUrl(waMessage);
---

<section id="cara-kerja" class="scroll-mt-20 bg-gray-50/50 py-16 sm:py-24 dark:bg-neutral-900/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-emerald-200/80 bg-emerald-50/70 px-3.5 py-1 text-xs font-semibold text-emerald-800 backdrop-blur-xs dark:border-emerald-800/60 dark:bg-emerald-950/40 dark:text-emerald-300"
      >
        <ShieldCheck class="size-3.5 text-emerald-600 dark:text-emerald-400" />
        <span>{badge}</span>
      </div>

      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl dark:text-white"
      >
        {headline}
      </h2>

      <p class="mt-4 text-base text-gray-600 sm:text-lg dark:text-neutral-300">
        {subheadline}
      </p>
    </div>

    <!-- 5 Steps Flow -->
    <div class="relative mt-14">
      <!-- Steps Grid -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {
          steps.map((s, idx) => (
            <div class="group relative flex flex-col justify-between rounded-3xl border border-gray-200 bg-white p-6 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-emerald-500 hover:shadow-xl dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
              <div>
                <!-- Step Number & Badge -->
                <div class="flex items-center justify-between border-b border-gray-100 pb-4 dark:border-neutral-800">
                  <span class="inline-flex size-10 items-center justify-center rounded-2xl bg-emerald-50 font-mono text-base font-black text-emerald-700 transition-colors group-hover:bg-emerald-600 group-hover:text-white dark:bg-emerald-950/60 dark:text-emerald-400 dark:group-hover:bg-emerald-600">
                    {s.step}
                  </span>
                  <span class="text-[10px] font-bold tracking-wider text-gray-400 uppercase dark:text-neutral-500">
                    Fase {idx + 1}
                  </span>
                </div>

                <!-- Step Title -->
                <h3 class="mt-4 text-base font-bold text-gray-900 transition-colors group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-400">
                  {s.title}
                </h3>

                <!-- Step Description -->
                <p class="mt-2 text-xs leading-relaxed text-gray-600 dark:text-neutral-400">
                  {s.desc}
                </p>
              </div>

              <!-- Step Status Indicator -->
              <div class="mt-6 flex items-center gap-1.5 border-t border-gray-100 pt-3 text-[11px] font-medium text-emerald-700 dark:border-neutral-800 dark:text-emerald-400">
                <CheckCircle2 class="size-3.5" />
                <span>Terstandarisasi</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Reassurance Banner & Direct Consultation -->
    <div
      class="mt-12 rounded-3xl border border-emerald-200/80 bg-gradient-to-r from-emerald-50/80 via-white to-emerald-50/80 p-6 sm:p-8 dark:border-emerald-800/50 dark:from-emerald-950/20 dark:via-(--color-deep-space-blue-950) dark:to-emerald-950/20"
    >
      <div class="flex flex-col items-center justify-between gap-6 lg:flex-row">
        <div class="flex items-center gap-4 text-left">
          <div
            class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-md shadow-emerald-600/20"
          >
            <Headphones class="size-6" />
          </div>
          <div>
            <h4 class="text-base font-bold text-gray-900 dark:text-white">
              Migrasi Data Aman & Pendampingan Penuh Tanpa Downtime
            </h4>
            <p class="mt-1 text-xs text-gray-600 sm:text-sm dark:text-neutral-300">
              Tim spesialis Kriya membersihkan data spreadsheet lama Anda, memvalidasi NIK duplikat, dan mengonfigurasi saldo awal PSAK 109 hingga tervalidasi siap audit.
            </p>
          </div>
        </div>

        <div class="shrink-0">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] items-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-xs font-semibold text-white shadow-md shadow-emerald-600/20 transition-all hover:bg-emerald-700 hover:shadow-lg focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:outline-hidden sm:text-sm"
          >
            <span>{ctaLabel}</span>
            <ArrowRight class="size-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
