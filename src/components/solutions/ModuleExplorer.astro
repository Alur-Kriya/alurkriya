---
import { Check, Sparkles } from '@lucide/astro';
import 'swiper/css';

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  modules: Array<{
    id: string;
    number: string;
    title: string;
    icon: string;
    summary: string;
    features: Array<{
      name: string;
      desc: string;
    }>;
  }>;
}

const {
  badge,
  title = 'Fitur & Modul Lengkap Sistem Kriya',
  subtitle = 'Seluruh lingkup di bawah ini dirancang terstruktur dan dapat disesuaikan mengikuti kebutuhan operasional Anda.',
  modules,
} = Astro.props;

const displayBadge = badge || `${modules.length} Modul & Layanan Terintegrasi`;
---

<section id="modul-lengkap" class="scroll-mt-20 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-emerald-200/80 bg-emerald-50/70 px-3.5 py-1 text-xs font-semibold text-emerald-800 backdrop-blur-xs dark:border-emerald-800/60 dark:bg-emerald-950/40 dark:text-emerald-300"
      >
        <Sparkles class="size-3.5 text-emerald-600 dark:text-emerald-400" />
        <span>{displayBadge}</span>
      </div>
      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl dark:text-white"
      >
        {title}
      </h2>
      <p class="mt-4 text-base text-gray-600 sm:text-lg dark:text-neutral-300">
        {subtitle}
      </p>
    </div>

    <!-- Modul Explorer Root -->
    <div
      id="module-explorer-root"
      class="mx-auto mt-12 max-w-full"
      data-total-modules={modules.length}
    >
      <!-- Quick Jump Module Selector -->
      <div
        class="mb-8 flex flex-wrap items-center justify-center gap-1.5 sm:gap-2"
        aria-label="Pilihan Cepat Modul ERP"
      >
        {
          modules.map((m, idx) => (
            <button
              type="button"
              class={`nav-quick-jump inline-flex min-h-[38px] items-center gap-1.5 rounded-xl border px-3 py-1.5 text-xs font-semibold transition-all focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:outline-hidden ${
                idx === 0
                  ? 'border-emerald-500 bg-emerald-50 text-emerald-700 shadow-2xs ring-2 ring-emerald-500/20 dark:border-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300'
                  : 'border-gray-200 bg-white text-gray-700 shadow-2xs hover:border-emerald-400 hover:bg-emerald-50/50 hover:text-emerald-700 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:border-emerald-500 dark:hover:bg-neutral-700'
              }`}
              data-jump-index={idx}
            >
              <span class="font-mono text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
                {m.number}
              </span>
              <span class="hidden md:inline">{m.title.split('&')[0].split('(')[0].trim()}</span>
              <span class="md:hidden">{m.title.split(' ')[0]}</span>
            </button>
          ))
        }
      </div>

      <!-- Tab Content Panels -->
      <div class="swiper module-swiper overflow-hidden rounded-3xl">
        <div class="swiper-wrapper">
          {
            modules.map((m, idx) => {
              return (
                <div
                  id={`tab-panel-${m.id}`}
                  class="swiper-slide module-panel h-auto"
                  role="tabpanel"
                  data-panel-module-id={m.id}
                  data-index={idx}
                  data-module-number={m.number}
                  data-module-title={m.title}
                >
                  <div class="h-full rounded-3xl border border-gray-200 bg-white p-6 shadow-lg sm:p-10 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
                    {/* Module Header */}
                    <div class="flex flex-col justify-between gap-4 border-b border-gray-100 pb-6 sm:flex-row sm:items-center dark:border-neutral-800">
                      <div>
                        <div class="flex flex-wrap items-center gap-2">
                          <span class="rounded-md bg-emerald-100 px-2.5 py-0.5 font-mono text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
                            Modul {m.number}
                          </span>
                          <span class="text-xs font-semibold text-gray-500 dark:text-neutral-400">
                            Standar ERP ZISWAF
                          </span>
                        </div>
                        <h3 class="mt-2 text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl dark:text-white">
                          {m.title}
                        </h3>
                        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-600 sm:text-base dark:text-neutral-300">
                          {m.summary}
                        </p>
                      </div>

                      <div class="shrink-0">
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3.5 py-1 text-xs font-bold text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                          ✓ Siap Digunakan & Dapat Disesuaikan
                        </span>
                      </div>
                    </div>

                    {/* Sub-Features Section */}
                    <div class="mt-8">
                      <div class="mb-4 flex items-center justify-between">
                        <h4 class="text-xs font-bold tracking-wider text-gray-600 uppercase dark:text-neutral-400">
                          Sub-Fitur & Kapabilitas Terpadu ({m.features.length} Fitur):
                        </h4>
                      </div>
                      <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
                        {m.features.map((f) => (
                          <div class="rounded-2xl border border-gray-100 bg-gray-50/60 p-4 transition-all duration-200 hover:border-emerald-200 hover:bg-white hover:shadow-sm dark:border-neutral-800/80 dark:bg-neutral-900/40 dark:hover:border-emerald-900/40 dark:hover:bg-neutral-900">
                            <div class="flex items-start gap-2.5">
                              <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-400">
                                <Check class="size-3" />
                              </span>
                              <div>
                                <h5 class="text-sm font-bold text-gray-900 dark:text-white">
                                  {f.name}
                                </h5>
                                <p class="mt-1 text-xs leading-relaxed text-gray-600 dark:text-neutral-400">
                                  {f.desc}
                                </p>
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Keyboard, A11y } from 'swiper/modules';

  function initModuleExplorer() {
    const root = document.getElementById('module-explorer-root');
    if (!root) return;

    const quickJumpBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.nav-quick-jump'));
    if (!quickJumpBtns.length) return;

    // Initialize Swiper instance
    const swiper = new Swiper('.module-swiper', {
      modules: [Keyboard, A11y],
      slidesPerView: 1,
      spaceBetween: 32,
      autoHeight: true,
      speed: 400,
      grabCursor: true,
      touchEventsTarget: 'container',
      resistanceRatio: 0.85,
      keyboard: {
        enabled: true,
        onlyInViewport: true,
      },
      on: {
        slideChange: function () {
          updateActiveJumpBtn(this.activeIndex);
        },
      },
    });

    function updateActiveJumpBtn(currentIndex: number) {
      quickJumpBtns.forEach((btn, idx) => {
        const isActive = idx === currentIndex;
        if (isActive) {
          btn.classList.add(
            'border-emerald-500',
            'bg-emerald-50',
            'text-emerald-700',
            'ring-2',
            'ring-emerald-500/20',
            'dark:border-emerald-700',
            'dark:bg-emerald-950/60',
            'dark:text-emerald-300'
          );
          btn.classList.remove(
            'border-gray-200',
            'bg-white',
            'text-gray-700',
            'dark:border-neutral-700',
            'dark:bg-neutral-800',
            'dark:text-neutral-300'
          );
        } else {
          btn.classList.remove(
            'border-emerald-500',
            'bg-emerald-50',
            'text-emerald-700',
            'ring-2',
            'ring-emerald-500/20',
            'dark:border-emerald-700',
            'dark:bg-emerald-950/60',
            'dark:text-emerald-300'
          );
          btn.classList.add(
            'border-gray-200',
            'bg-white',
            'text-gray-700',
            'dark:border-neutral-700',
            'dark:bg-neutral-800',
            'dark:text-neutral-300'
          );
        }
      });
    }

    // Quick Jump Button Click Handlers
    quickJumpBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetIdx = parseInt(btn.getAttribute('data-jump-index') || '0', 10);
        swiper.slideTo(targetIdx);
      });
    });

    // Initial active pill state
    updateActiveJumpBtn(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModuleExplorer);
  } else {
    initModuleExplorer();
  }
  document.addEventListener('astro:page-load', initModuleExplorer);
</script>
