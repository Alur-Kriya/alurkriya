---
import { Check } from '@lucide/astro';

interface Props {
  modules: Array<{
    id: string;
    number: string;
    title: string;
    icon: string;
    summary: string;
    features: Array<{
      name: string;
      desc: string;
    }>;
  }>;
}

const { modules } = Astro.props;
---

<section id="modul-lengkap" class="scroll-mt-20 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">

      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl dark:text-white"
      >
        Fitur & Modul Lengkap Software ZISWAF ERP
      </h2>
      <p class="mt-4 text-base text-gray-600 sm:text-lg dark:text-neutral-300">
        Seluruh modul di bawah ini sudah saling terintegrasi dalam paket standar, dan dapat
        disesuaikan (customized) mengikuti SOP dan alur otorisasi lembaga Anda.
      </p>
    </div>

    <!-- Modul Explorer (Tabs Layout on Desktop, Card Flow on Mobile) -->
    <div class="mt-14">
      <!-- Tabs Navigation -->
      <div class="border-b border-gray-200 dark:border-neutral-800">
        <nav
          class="-mb-px flex gap-2 overflow-x-auto pb-2 [&::-webkit-scrollbar]:h-1 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-gray-300 dark:[&::-webkit-scrollbar-thumb]:bg-neutral-600"
          aria-label="Tabs Modul ERP"
          role="tablist"
        >
          {
            modules.map((m, idx) => (
              <button
                type="button"
                class={`hs-tab-active:border-emerald-600 hs-tab-active:text-emerald-600 dark:hs-tab-active:border-emerald-400 dark:hs-tab-active:text-emerald-400 inline-flex shrink-0 items-center gap-x-2 border-b-2 px-4 py-3 text-xs font-semibold text-gray-500 hover:text-gray-700 sm:text-sm dark:text-neutral-400 dark:hover:text-neutral-300 ${
                  idx === 0
                    ? 'active border-emerald-600 text-emerald-600 dark:border-emerald-400 dark:text-emerald-400'
                    : 'border-transparent'
                }`}
                id={`tab-item-${m.id}`}
                data-hs-tab={`#tab-panel-${m.id}`}
                aria-controls={`tab-panel-${m.id}`}
                role="tab"
              >
                <span class="font-mono text-xs opacity-60">{m.number}</span>
                <span>{m.title.split('&')[0].trim()}</span>
              </button>
            ))
          }
        </nav>
      </div>

      <!-- Tab Content Panels -->
      <div class="mt-8">
        {
          modules.map((m, idx) => (
            <div
              id={`tab-panel-${m.id}`}
              class={idx === 0 ? '' : 'hidden'}
              role="tabpanel"
              aria-labelledby={`tab-item-${m.id}`}
            >
              <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-lg sm:p-10 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
                <div class="flex flex-col justify-between gap-4 border-b border-gray-100 pb-6 sm:flex-row sm:items-center dark:border-neutral-800">
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="rounded-md bg-emerald-100 px-2.5 py-0.5 font-mono text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
                        Modul {m.number}
                      </span>
                      <span class="text-xs font-semibold text-gray-500 dark:text-neutral-400">
                        Standar ERP ZISWAF
                      </span>
                    </div>
                    <h3 class="mt-2 text-2xl font-extrabold text-gray-900 sm:text-3xl dark:text-white">
                      {m.title}
                    </h3>
                    <p class="mt-2 max-w-2xl text-sm text-gray-600 dark:text-neutral-300">
                      {m.summary}
                    </p>
                  </div>

                  <div class="shrink-0">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                      ✓ Siap Digunakan & Dapat Disesuaikan
                    </span>
                  </div>
                </div>

                <div class="mt-8">
                  <h4 class="mb-4 text-xs font-bold tracking-wider text-gray-400 uppercase dark:text-neutral-500">
                    Sub-Fitur & Kapabilitas Terpadu:
                  </h4>
                  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {m.features.map((f) => (
                      <div class="rounded-2xl border border-gray-100 bg-gray-50/60 p-4 transition-all duration-200 hover:border-emerald-200 hover:bg-white hover:shadow-sm dark:border-neutral-800/80 dark:bg-neutral-900/40 dark:hover:border-emerald-900/40 dark:hover:bg-neutral-900">
                        <div class="flex items-start gap-2.5">
                          <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-400">
                            <Check class="size-3" />
                          </span>
                          <div>
                            <h5 class="text-sm font-bold text-gray-900 dark:text-white">
                              {f.name}
                            </h5>
                            <p class="mt-1 text-xs leading-relaxed text-gray-600 dark:text-neutral-400">
                              {f.desc}
                            </p>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
