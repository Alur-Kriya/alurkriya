---
import {
  Cpu,
  CheckCircle2,
  ShieldCheck,
  Zap,
  Wifi,
  Server,
  Network,
  SlidersHorizontal,
  AlertTriangle,
} from '@lucide/astro';

interface HardwareBrand {
  name: string;
  badge: string;
  specialization: string;
  recommendedFor: string;
  devices: string[];
  features: string[];
}

interface Props {
  hardware?: HardwareBrand[];
}

const defaultHardware: HardwareBrand[] = [
  {
    name: 'Ubiquiti UniFi',
    badge: 'Enterprise Wi-Fi & Switching',
    specialization:
      'Solusi ekosistem terpadu untuk jangkauan sinyal merata, seamless fast roaming 802.11k/v/r, dan kontrol visual terpusat.',
    recommendedFor:
      'Kantor UKM, ruko modern bertingkat, coworking space, dan hunian bertingkat premium.',
    devices: ['UniFi U6-Pro / U6+ Wi-Fi 6 AP', 'UniFi Switch PoE+ Gigabit', 'UniFi Cloud Gateway'],
    features: [
      'Fast BSS transition untuk perpindahan sinyal antar lantai tanpa jeda putus',
      'Desain ceiling mount minimalis elegan yang menyatu dengan estetika plafon',
      'Dashboard UniFi Controller terpusat untuk monitoring perangkat dan klien',
      'Dukungan multi-SSID dan isolasi VLAN tamu berbasis hardware',
    ],
  },
  {
    name: 'MikroTik RouterOS',
    badge: 'Core Gateway & Bandwidth Shaper',
    specialization:
      'Router performa tinggi untuk pembagian bandwidth adil, proteksi firewall berlapis, dan kestabilan routing tanpa henti.',
    recommendedFor:
      'Perkantoran dengan banyak divisi, sistem kasir POS, gudang logistik, dan manajemen multi-WAN.',
    devices: [
      'MikroTik hEX Series (Gigabit)',
      'MikroTik RB5009 / CCR',
      'MikroTik Cloud Router Switch',
    ],
    features: [
      'Dynamic Queue Tree & PCQ untuk membagi bandwidth secara adil tanpa monopoli',
      'Prioritas jalur kritis (QoS) untuk sistem kasir POS, database kantor, dan VoIP',
      'Multi-WAN failover otomatis mengalihkan koneksi ke ISP cadangan saat ISP utama putus',
      'Firewall filtering andal untuk memblokir akses situs berbahaya dan serangan jaringan',
    ],
  },
  {
    name: 'Ruijie Reyee',
    badge: 'Cloud-Managed Mesh & Smart Gateway',
    specialization:
      'Perangkat jaringan kelas komersial dengan teknologi Self-Organizing Network (SON) dan kemudahan manajemen berbasis cloud.',
    recommendedFor:
      'Ruko bisnis, kafe/restoran, penginapan/villa, dan hunian residensial bertingkat.',
    devices: [
      'Reyee RG-RAP Wi-Fi 6 AP',
      'Reyee Smart Managed PoE Switch',
      'Reyee Cloud Gateway Router',
    ],
    features: [
      'Self-Organizing Network untuk konfigurasi mesh dan optimasi sinyal otomatis',
      'Pemantauan status jaringan real-time melalui aplikasi mobile Reyee Cloud',
      'Pemisahan jaringan tamu dengan captive portal selamat datang yang elegan',
      'Performa Wi-Fi 6 stabil dengan rasio biaya investasi yang sangat efisien',
    ],
  },
  {
    name: 'Aruba Instant On (HPE)',
    badge: 'Business-Grade Security & Reliability',
    specialization:
      'Infrastruktur nirkabel dari Hewlett Packard Enterprise (HPE) yang dirancang untuk keandalan dan keamanan data tingkat bisnis.',
    recommendedFor:
      'Kantor cabang, klinik kesehatan, studio kreatif, dan bisnis dengan beban koneksi tinggi.',
    devices: [
      'Aruba Instant On AP22 / AP25 Wi-Fi 6',
      'Aruba 1930 Series Smart Switch',
      'PoE Injector Gigabit',
    ],
    features: [
      'Standar enkripsi WPA3 dan fitur keamanan terpasang tanpa biaya lisensi tambahan',
      'Optimasi otomatis untuk voice dan video conference agar bebas stuttering',
      'Manajemen ganda melalui aplikasi mobile atau web browser lokal',
      'Kualitas hardware kelas enterprise global dengan durabilitas jangka panjang',
    ],
  },
];

const { hardware = defaultHardware } = Astro.props;

// Brand configuration presets for visual styling
const brandStyles: Record<
  string,
  {
    gradient: string;
    borderAccent: string;
    badgeBg: string;
    badgeText: string;
    techTagBg: string;
    techTagText: string;
    icon: typeof Wifi;
    role: string;
  }
> = {
  'Ubiquiti UniFi': {
    gradient: 'from-sky-500/10 via-blue-500/5 to-transparent',
    borderAccent: 'group-hover:border-sky-500/60 dark:group-hover:border-sky-400/60',
    badgeBg: 'bg-sky-100 text-sky-900 dark:bg-sky-950/80 dark:text-sky-300',
    badgeText: 'Ubiquiti SDN Eco',
    techTagBg: 'bg-sky-50 text-sky-800 dark:bg-sky-950/50 dark:text-sky-300',
    techTagText: 'Seamless 802.11k/v/r',
    icon: Wifi,
    role: 'Distribusi Wi-Fi & Switching',
  },
  'MikroTik RouterOS': {
    gradient: 'from-rose-500/10 via-red-500/5 to-transparent',
    borderAccent: 'group-hover:border-rose-500/60 dark:group-hover:border-rose-400/60',
    badgeBg: 'bg-rose-100 text-rose-900 dark:bg-rose-950/80 dark:text-rose-300',
    badgeText: 'RouterOS Core',
    techTagBg: 'bg-rose-50 text-rose-800 dark:bg-rose-950/50 dark:text-rose-300',
    techTagText: 'Bandwidth QoS & Firewall',
    icon: SlidersHorizontal,
    role: 'Core Gateway & Bandwidth Shaper',
  },
  'Ruijie Reyee': {
    gradient: 'from-teal-500/10 via-emerald-500/5 to-transparent',
    borderAccent: 'group-hover:border-teal-500/60 dark:group-hover:border-teal-400/60',
    badgeBg: 'bg-teal-100 text-teal-900 dark:bg-teal-950/80 dark:text-teal-300',
    badgeText: 'Cloud SON Mesh',
    techTagBg: 'bg-teal-50 text-teal-800 dark:bg-teal-950/50 dark:text-teal-300',
    techTagText: 'Self-Organizing Network',
    icon: Network,
    role: 'Cloud Mesh & Smart Gateway',
  },
  'Aruba Instant On (HPE)': {
    gradient: 'from-amber-500/10 via-orange-500/5 to-transparent',
    borderAccent: 'group-hover:border-amber-500/60 dark:group-hover:border-amber-400/60',
    badgeBg: 'bg-amber-100 text-amber-900 dark:bg-amber-950/80 dark:text-amber-300',
    badgeText: 'HPE Enterprise',
    techTagBg: 'bg-amber-50 text-amber-800 dark:bg-amber-950/50 dark:text-amber-300',
    techTagText: 'WPA3 Enterprise Security',
    icon: ShieldCheck,
    role: 'High-Security Commercial Wi-Fi',
  },
};
---

<section
  id="hardware-ecosystem"
  class="relative scroll-mt-20 border-t border-gray-100 bg-gray-50/70 py-16 sm:py-24 dark:border-neutral-800 dark:bg-neutral-900/40"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3.5 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300"
      >
        <Cpu class="size-3.5 text-emerald-600 dark:text-emerald-400" />
        Standar Perangkat Keras Teruji
      </span>
      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
      >
        Didukung Ekosistem Hardware Enterprise Berkualitas Tinggi
      </h2>
      <p class="mt-4 text-base text-gray-600 sm:text-lg dark:text-neutral-300">
        Alur Kriya Teknologi memilih perangkat jaringan standar industri yang dirancang untuk beban
        kerja intensif, efisiensi termal yang baik, serta dukungan pembaruan firmware jangka panjang
        guna menjaga kestabilan koneksi bangunan Anda.
      </p>
    </div>

    <!-- 4 Branded Hardware Showcase Cards -->
    <div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-2">
      {
        hardware.map((item) => {
          const style = brandStyles[item.name] || {
            gradient: 'from-emerald-500/10 to-transparent',
            borderAccent: 'group-hover:border-emerald-500/60',
            badgeBg: 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950/80 dark:text-emerald-300',
            badgeText: 'Enterprise Grade',
            techTagBg: 'bg-emerald-50 text-emerald-800',
            techTagText: 'Hardware Certified',
            icon: Server,
            role: item.badge,
          };
          const BrandIcon = style.icon;

          return (
            <div
              class={`group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-gray-200/90 bg-white p-6 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:shadow-xl sm:p-8 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950) ${style.borderAccent}`}
            >
              {/* Ambient Subtle Header Gradient */}
              <div
                class={`pointer-events-none absolute inset-x-0 top-0 h-32 bg-linear-to-b ${style.gradient}`}
              />

              <div class="relative z-10">
                {/* Header with Brand Icon, Name, and Role */}
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 pb-5 dark:border-neutral-800">
                  <div class="flex items-center gap-3">
                    <div class="flex size-11 items-center justify-center rounded-2xl bg-gray-100 shadow-2xs dark:bg-neutral-800/90">
                      <BrandIcon class="size-5.5 text-gray-800 dark:text-white" />
                    </div>
                    <div>
                      <h3 class="text-xl font-extrabold tracking-tight text-gray-900 sm:text-2xl dark:text-white">
                        {item.name}
                      </h3>
                      <p class="text-xs font-semibold text-gray-500 dark:text-neutral-400">
                        {style.role}
                      </p>
                    </div>
                  </div>

                  <span
                    class={`inline-flex items-center rounded-lg px-2.5 py-1 text-xs font-bold ${style.badgeBg}`}
                  >
                    {style.badgeText}
                  </span>
                </div>

                {/* Specialization */}
                <p class="mt-4 text-sm leading-relaxed text-gray-600 dark:text-neutral-300">
                  {item.specialization}
                </p>

                {/* Ideal For Box */}
                <div class="mt-5 rounded-2xl border border-gray-200/70 bg-gray-50/80 p-3.5 dark:border-neutral-800/80 dark:bg-neutral-900/60">
                  <span class="block text-[11px] font-bold tracking-wider text-gray-500 uppercase dark:text-neutral-400">
                    Ideal untuk Skenario:
                  </span>
                  <p class="mt-1 text-xs font-semibold text-gray-900 dark:text-neutral-200">
                    {item.recommendedFor}
                  </p>
                </div>

                {/* Devices Used */}
                <div class="mt-5">
                  <div class="flex items-center justify-between">
                    <h4 class="text-xs font-bold tracking-wider text-gray-500 uppercase dark:text-neutral-400">
                      Model Perangkat yang Biasa Digunakan:
                    </h4>
                    <span class={`rounded-md px-2 py-0.5 text-[10px] font-bold ${style.techTagBg}`}>
                      {style.techTagText}
                    </span>
                  </div>
                  <div class="mt-2.5 flex flex-wrap gap-1.5">
                    {item.devices.map((device) => (
                      <span class="rounded-lg border border-gray-200/80 bg-white px-2.5 py-1 text-xs font-semibold text-gray-800 shadow-2xs dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200">
                        {device}
                      </span>
                    ))}
                  </div>
                </div>

                {/* Technical Features */}
                <div class="mt-6 border-t border-gray-100 pt-5 dark:border-neutral-800">
                  <h4 class="text-xs font-bold tracking-wider text-gray-500 uppercase dark:text-neutral-400">
                    Keunggulan Rekayasa Jaringan:
                  </h4>
                  <ul class="mt-3 space-y-2.5">
                    {item.features.map((feat) => (
                      <li class="flex items-start gap-2.5 text-xs font-medium text-gray-700 dark:text-neutral-300">
                        <CheckCircle2 class="mt-0.5 size-4 shrink-0 stroke-[2.5] text-emerald-600 dark:text-emerald-400" />
                        <span class="leading-relaxed">{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Technical Contrast Callout: Why NOT cheap wireless repeaters -->
    <div
      class="mt-14 overflow-hidden rounded-3xl border border-amber-200/80 bg-linear-to-br from-amber-50/90 via-white to-amber-50/40 p-6 shadow-md sm:p-8 dark:border-amber-900/40 dark:from-amber-950/30 dark:via-(--color-deep-space-blue-950) dark:to-neutral-900/40"
    >
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2">
            <span
              class="flex size-7 items-center justify-center rounded-lg bg-amber-500 text-white shadow-xs"
            >
              <AlertTriangle class="size-4 stroke-[2.5]" />
            </span>
            <span
              class="text-xs font-bold tracking-wider text-amber-800 uppercase dark:text-amber-300"
            >
              Prinsip Fisika & Rekayasa Jaringan
            </span>
          </div>
          <h3
            class="mt-3 text-xl font-bold tracking-tight text-gray-900 sm:text-2xl dark:text-white"
          >
            Mengapa Kami Menyarankan Backbone Kabel Dibandingkan Wi-Fi Extender Nirkabel?
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-700 dark:text-neutral-300">
            Wi-Fi repeater nirkabel beroperasi secara <strong
              class="font-bold text-gray-900 dark:text-white">half-duplex</strong
            > (menerima lalu memancarkan ulang pada kanal frekuensi radio yang sama). Hal ini berpotensi
            menurunkan throughput secara signifikan dan meningkatkan latensi tergantung pada jarak antartitik,
            redaman dinding cor semen, serta interferensi frekuensi di sekitar lokasi.
          </p>
        </div>

        <div
          class="shrink-0 rounded-2xl border border-amber-200 bg-white/90 p-4 shadow-xs dark:border-neutral-700 dark:bg-neutral-800/90"
        >
          <p class="text-xs font-bold text-gray-500 uppercase dark:text-neutral-400">
            Standar Rekayasa Kriya:
          </p>
          <div
            class="mt-2 flex items-center gap-2 text-sm font-extrabold text-emerald-700 dark:text-emerald-400"
          >
            <Zap class="size-4 shrink-0 fill-current" />
            <span>Backbone Kabel Cat6 Gigabit PoE</span>
          </div>
          <p class="mt-1 text-[11px] text-gray-600 dark:text-neutral-400">
            Jalur data fisik terdedikasi untuk transmisi stabil di setiap lantai.
          </p>
        </div>
      </div>
    </div>

    <!-- Internal Linking Context -->
    <div
      class="mt-10 rounded-2xl border border-gray-200/80 bg-white p-5 text-sm text-gray-600 sm:flex sm:items-center sm:justify-between dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950) dark:text-neutral-300"
    >
      <div>
        <p class="font-bold text-gray-900 dark:text-white">
          Butuh pengadaan perangkat hardware atau evaluasi arsitektur IT secara menyeluruh?
        </p>
        <p class="mt-0.5 text-xs text-gray-500 dark:text-neutral-400">
          Kriya menyediakan layanan pengadaan resmi dan konsultasi infrastruktur digital bisnis.
        </p>
      </div>
      <div class="mt-3 flex flex-wrap gap-2 sm:mt-0">
        <a
          href="/jasa/it-procurement-support"
          class="inline-flex min-h-[44px] items-center rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-100 hover:text-emerald-700 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700"
        >
          IT Procurement & Support
        </a>
        <a
          href="/jasa/it-consulting"
          class="inline-flex min-h-[44px] items-center rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-100 hover:text-emerald-700 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700"
        >
          IT Consulting
        </a>
      </div>
    </div>
  </div>
</section>
