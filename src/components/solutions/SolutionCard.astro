---
import DemoButton from './DemoButton.astro';
import { ChevronRight } from '@lucide/astro';

interface Props {
  solution: {
    slug: string;
    name: string;
    tagline: string;
    category: string;
    badge: string;
    description: string;
    images?: {
      hero?: string;
    };
    stats?: Array<{ value: string; label: string }>;
    modules?: Array<{ title: string }>;
    modulesLabel?: string;
    demoButtonLabel?: string;
    waMessage?: string;
  };
}

const { solution } = Astro.props;
---

<div
  class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-gray-200 bg-white p-6 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-emerald-500/40 hover:shadow-2xl md:p-8 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950) dark:hover:border-emerald-500/40"
>
  <div>
    <!-- Top Tags -->
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300"
      >
        <span class="size-1.5 rounded-full bg-emerald-500"></span>
        {solution.badge}
      </span>
      <span
        class="text-xs font-semibold tracking-wider text-gray-400 uppercase dark:text-neutral-500"
      >
        {solution.category}
      </span>
    </div>

    <!-- Product Image Preview -->
    {
      solution.images?.hero && (
        <a
          href={`/solusi/${solution.slug}`}
          class="mt-6 block overflow-hidden rounded-2xl border border-gray-100 bg-gray-50 dark:border-neutral-800 dark:bg-neutral-900/60"
        >
          <img
            src={solution.images.hero}
            alt={solution.name}
            class="h-56 w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </a>
      )
    }

    <!-- Title & Tagline -->
    <div class="mt-6">
      <h3
        class="text-2xl font-bold tracking-tight text-gray-900 transition-colors group-hover:text-emerald-600 dark:text-white dark:group-hover:text-emerald-400"
      >
        <a href={`/solusi/${solution.slug}`}>
          {solution.name}
        </a>
      </h3>
      <p class="mt-1 text-sm font-medium text-emerald-700 dark:text-emerald-400">
        {solution.tagline}
      </p>
      <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-gray-600 dark:text-neutral-400">
        {solution.description}
      </p>
    </div>
  </div>

  <!-- Action CTAs -->
  <div
    class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-gray-100 pt-6 dark:border-neutral-800"
  >
    <a
      href={`/solusi/${solution.slug}`}
      class="inline-flex min-h-[44px] items-center gap-x-1.5 rounded-md py-2 text-sm font-semibold text-(--color-steel-blue-800) transition-colors hover:text-emerald-600 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:ring-offset-2 focus-visible:outline-hidden dark:text-blue-400 dark:hover:text-emerald-300 dark:focus-visible:ring-offset-neutral-900"
    >
      <span>Lihat Fitur & Solusi Lengkap</span>
      <ChevronRight class="size-4" />
    </a>

    <DemoButton
      label={solution.demoButtonLabel || 'Minta Demo'}
      size="sm"
      variant="emerald"
      message={solution.waMessage ||
        `Halo Kriya, saya tertarik dan ingin minta sesi konsultasi untuk ${solution.name}.`}
    />
  </div>
</div>
