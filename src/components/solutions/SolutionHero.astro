---
import { Picture } from 'astro:assets';
import heroImg from '@images/solusi/hero.jpg';
import { getWaUrl } from '@lib/whatsapp';
import { ChevronRight, MessageCircle } from '@lucide/astro';

interface Props {
  heading?: string;
  description?: string;
  waMessage?: string;
}

const {
  heading = 'Software ZISWAF ERP',
  description = 'Satu sistem ERP terintegrasi untuk seluruh operasional lembaga amil zakat. Menyatukan penghimpunan donasi, kasir ZIS, akuntansi PSAK 109, penyaluran 8 Asnaf, persetujuan PPD berjenjang, dan tata kelola amil dalam satu platform siap audit.',
  waMessage = 'Halo Kriya, saya ingin request sesi demo Software ZISWAF ERP untuk lembaga kami.',
} = Astro.props;

const waUrl = getWaUrl(waMessage);
---

<!-- Hero -->
<div class="mx-auto max-w-[85rem] px-4 py-30 sm:px-6 lg:px-8">
  <!-- Grid -->
  <div class="grid lg:grid-cols-7 lg:items-center lg:gap-x-8 xl:gap-x-12">
    <div class="lg:col-span-3">
      <h1
        class="block text-3xl font-bold text-gray-800 sm:text-4xl md:text-5xl lg:text-6xl dark:text-white"
      >
        <span class="text-(--color-fresh-sky-500) dark:text-(--color-fresh-sky-500)">{heading}</span
        >
      </h1>
      <p class="mt-3 text-lg text-gray-800 dark:text-neutral-400">
        {description}
      </p>

      <!-- Buttons -->
      <div class="mt-7 grid w-full gap-3 sm:inline-flex">
        <a
          class="button inline-flex items-center justify-center gap-x-2 rounded-lg border border-transparent bg-(--color-steel-blue-800) px-4 py-3 text-sm font-medium text-white hover:bg-(--color-steel-blue-700) focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-(--color-steel-blue-700) dark:hover:bg-(--color-steel-blue-600)"
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <MessageCircle class="size-4 shrink-0 text-white" />
          Minta Demo via WhatsApp
          <ChevronRight class="size-4 shrink-0" />
        </a>

        <a
          class="inline-flex items-center justify-center gap-x-2 rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-800 shadow-2xs hover:bg-gray-50 focus:bg-gray-50 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700"
          href="#modul-lengkap"
        >
          Lihat 11 Modul ERP
        </a>
      </div>
      <!-- End Buttons -->
    </div>
    <!-- End Col -->

    <div class="mt-10 lg:col-span-4 lg:mt-0">
      <Picture
        src={heroImg}
        alt="Software ZISWAF ERP - PT Alur Kriya Teknologi"
        class="w-full rounded-xl object-cover shadow-lg"
        draggable="false"
        loading="eager"
        decoding="async"
        formats={['avif', 'webp']}
        priority
      />
    </div>
    <!-- End Col -->
  </div>
  <!-- End Grid -->
</div>
<!-- End Hero -->
