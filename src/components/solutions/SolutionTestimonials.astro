---
import { Star } from '@lucide/astro';

interface Props {
  testimonials: Array<{
    quote: string;
    author: string;
    role: string;
    institution: string;
  }>;
}

const { testimonials } = Astro.props;
---

<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">

      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
      >
        Dipercaya oleh Praktisi & Pimpinan Lembaga ZISWAF
      </h2>
      <p class="mt-4 text-base text-gray-600 sm:text-lg dark:text-neutral-300">
        Dengarkan bagaimana transformasi ke sistem Software ZISWAF ERP memberikan dampak nyata bagi
        kelancaran operasional dan akuntabilitas mereka.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="mt-14 grid gap-8 lg:grid-cols-3">
      {
        testimonials.map((t) => (
          <div class="flex flex-col justify-between rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-emerald-500/40 hover:shadow-xl dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
            <div>
              <div class="flex items-center gap-1">
                {Array.from({ length: 5 }).map(() => (
                  <Star class="size-4 fill-amber-400 text-amber-400" />
                ))}
              </div>

              <p class="mt-5 text-sm leading-relaxed text-gray-700 italic dark:text-neutral-300">
                "{t.quote}"
              </p>
            </div>

            <div class="mt-8 flex items-center gap-3.5 border-t border-gray-100 pt-5 dark:border-neutral-800">
              <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-emerald-100 font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                {t.author.charAt(0)}
              </div>
              <div>
                <h4 class="text-xs font-bold text-gray-900 dark:text-white">{t.author}</h4>
                <p class="text-[11px] font-medium text-emerald-700 dark:text-emerald-400">
                  {t.role}
                </p>
                <p class="text-[10px] text-gray-500 dark:text-neutral-400">{t.institution}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
