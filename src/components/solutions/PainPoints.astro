---
import { TriangleAlert, CircleAlert } from '@lucide/astro';

interface Props {
  painPoints: Array<{
    id: string;
    number: string;
    title: string;
    desc: string;
    impact: string;
  }>;
}

const { painPoints } = Astro.props;
---

<section id="pain-points" class="scroll-mt-20 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mx-auto max-w-3xl text-center">

      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl dark:text-white"
      >
        Apakah Lembaga Anda Sering Mengalami Hambatan Operasional Ini?
      </h2>

      <p class="mt-4 text-base text-gray-600 sm:text-lg dark:text-neutral-300">
        Mengelola dana amanah umat membutuhkan akurasi, kecepatan, dan transparansi tinggi. Namun
        banyak lembaga terhambat oleh proses manual yang lambat dan rawan risiko.
      </p>
    </div>

    <!-- 8 Pain Points Grid -->
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        painPoints.map((p) => (
          <div class="group relative flex flex-col justify-between rounded-3xl border border-gray-200 bg-white p-6 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-red-300 hover:shadow-xl dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950) dark:hover:border-red-900/50">
            <div>
              <div class="flex items-center justify-between border-b border-gray-100 pb-4 dark:border-neutral-800">
                <span class="font-mono text-2xl font-black text-red-500/80 group-hover:text-red-600 dark:text-red-400">
                  {p.number}
                </span>
                <span class="flex size-8 items-center justify-center rounded-xl bg-red-50 text-red-600 dark:bg-red-950/50 dark:text-red-400">
                  <CircleAlert class="size-4" />
                </span>
              </div>

              <h3 class="mt-4 text-base font-bold text-gray-900 transition-colors group-hover:text-red-600 dark:text-white dark:group-hover:text-red-400">
                {p.title}
              </h3>

              <p class="mt-2 text-xs leading-relaxed text-gray-600 dark:text-neutral-400">
                {p.desc}
              </p>
            </div>

            <div class="mt-6 rounded-2xl border border-red-100 bg-red-50/60 p-3.5 dark:border-red-900/30 dark:bg-red-950/20">
              <span class="block text-[10px] font-bold tracking-wider text-red-700 uppercase dark:text-red-300">
                Dampak Risiko:
              </span>
              <p class="mt-1 text-xs font-semibold text-red-950 dark:text-red-200">{p.impact}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
