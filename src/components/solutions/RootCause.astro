---
import { CircleX, Check } from '@lucide/astro';
interface Props {
  rootCause: {
    headline: string;
    subheadline: string;
    siloTitle?: string;
    siloSubtitle?: string;
    siloWarning?: string;
    solutionTitle?: string;
    solutionSubtitle?: string;
    solutionResult?: string;
    silo: Array<{ title: string; problem: string }>;
    erpSolution: Array<{ title: string; desc: string }>;
  };
}

const { rootCause } = Astro.props;

const siloTitle = rootCause.siloTitle || 'Kondisi Lama: Sistem Terpecah-Pecah (Silo)';
const siloSubtitle = rootCause.siloSubtitle || 'Amil habis waktu untuk merekap data secara manual';
const siloWarning =
  rootCause.siloWarning ||
  '⚠️ Akibatnya: Laporan selalu terlambat, selisih kas rawan terjadi, dan pimpinan tidak memiliki gambaran utuh kinerja lembaga.';
const solutionTitle = rootCause.solutionTitle || 'Solusi Kriya: Satu ERP Terintegrasi';
const solutionSubtitle =
  rootCause.solutionSubtitle || 'Seluruh divisi terhubung dalam satu database real-time';
const solutionResult =
  rootCause.solutionResult ||
  '✨ Hasil: Seluruh data terintegrasi real-time, nol selisih pembukuan, dan kepatuhan tata kelola terjamin.';
---

<section
  class="bg-gradient-to-b from-gray-50/60 to-white py-16 sm:py-24 dark:from-neutral-900/40 dark:to-(--color-deep-space-blue-900)"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
      >
        {rootCause.headline}
      </h2>
      <p class="mt-4 text-base text-gray-600 sm:text-lg dark:text-neutral-300">
        {rootCause.subheadline}
      </p>
    </div>

    <!-- Comparison Grid: Siloed Apps vs Integrated ERP Hub -->
    <div class="mt-14 grid gap-8 lg:grid-cols-2 lg:items-stretch">
      <!-- Left Column: The Problem - Fragmented Siloed Apps -->
      <div
        class="flex flex-col justify-between rounded-3xl border border-red-200/80 bg-red-50/20 p-6 sm:p-8 dark:border-red-900/40 dark:bg-red-950/10"
      >
        <div>
          <div class="flex items-center gap-3 border-b border-red-100 pb-5 dark:border-red-900/30">
            <span
              class="flex size-10 items-center justify-center rounded-2xl bg-red-100 text-red-600 dark:bg-red-950/60 dark:text-red-400"
            >
              <CircleX class="size-5" />
            </span>
            <div>
              <h3 class="text-lg font-bold text-red-900 dark:text-red-300">
                {siloTitle}
              </h3>
              <p class="text-xs text-red-700/80 dark:text-red-400">
                {siloSubtitle}
              </p>
            </div>
          </div>

          <div class="mt-6 space-y-4">
            {
              rootCause.silo.map((item, idx) => (
                <div class="flex items-start gap-3 rounded-2xl border border-red-100/80 bg-white/80 p-4 shadow-2xs dark:border-red-900/20 dark:bg-neutral-900/60">
                  <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-red-100 text-xs font-bold text-red-700 dark:bg-red-950 dark:text-red-300">
                    {idx + 1}
                  </span>
                  <div>
                    <h4 class="text-sm font-bold text-gray-900 dark:text-white">{item.title}</h4>
                    <p class="mt-1 text-xs text-gray-600 dark:text-neutral-400">{item.problem}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mt-8 rounded-2xl bg-red-100/60 p-4 text-center dark:bg-red-950/30">
          <p class="text-xs font-semibold text-red-900 dark:text-red-300">
            {siloWarning}
          </p>
        </div>
      </div>

      <!-- Right Column: The Answer - Integrated Hub -->
      <div
        class="flex flex-col justify-between rounded-3xl border border-emerald-300/80 bg-emerald-50/30 p-6 sm:p-8 dark:border-emerald-800/60 dark:bg-emerald-950/10"
      >
        <div>
          <div
            class="flex items-center gap-3 border-b border-emerald-100 pb-5 dark:border-emerald-900/30"
          >
            <span
              class="flex size-10 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-md shadow-emerald-600/20"
            >
              <Check class="size-5" />
            </span>
            <div>
              <h3 class="text-lg font-bold text-emerald-900 dark:text-emerald-300">
                {solutionTitle}
              </h3>
              <p class="text-xs text-emerald-700 dark:text-emerald-400">
                {solutionSubtitle}
              </p>
            </div>
          </div>

          <div class="mt-6 space-y-4">
            {
              rootCause.erpSolution.map((item, idx) => (
                <div class="flex items-start gap-3 rounded-2xl border border-emerald-100 bg-white/90 p-4 shadow-2xs dark:border-emerald-900/30 dark:bg-neutral-900/80">
                  <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                    {idx + 1}
                  </span>
                  <div>
                    <h4 class="flex items-center gap-2 text-sm font-bold text-gray-900 dark:text-white">
                      {item.title}
                      <span class="inline-block size-1.5 rounded-full bg-emerald-500" />
                    </h4>
                    <p class="mt-1 text-xs text-gray-600 dark:text-neutral-400">{item.desc}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="mt-8 rounded-2xl bg-emerald-600 p-4 text-center text-white shadow-md shadow-emerald-700/20"
        >
          <p class="text-xs font-bold">
            {solutionResult}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
