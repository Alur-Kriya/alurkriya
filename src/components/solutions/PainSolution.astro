---
import { getWaUrl } from '@lib/whatsapp';
import { Check, ArrowRight } from '@lucide/astro';

interface Props {
  deepDives?: Array<{
    id: string;
    badge: string;
    painTitle: string;
    painText: string;
    solutionTitle: string;
    solutionText: string;
    benefits: string[];
    icon: string;
  }>;
}

const solutionsBrief = [
  {
    domain: 'Penghimpunan & Donatur',
    icon: 'users',
    problem:
      'Data muzaki tercecer di Excel dan chat, follow-up manual lambat, komitmen donasi rutin mudah terputus.',
    solution:
      'Database Muzaki 360°, Schedule Donasi berkala otomatis, dan pipeline telemarketing amil terpadu.',
    outcomes: [
      'Retensi muzaki meningkat signifikan',
      'Pengingat donasi rutin otomatis via WhatsApp',
      'Riwayat donasi seumur hidup tercatat rapi',
    ],
    waMsg: 'Halo Kriya, saya ingin konsultasi modul Penghimpunan & Donatur di Software ZISWAF ERP.',
  },
  {
    domain: 'Kasir ZIS & Rekonsiliasi Bank',
    icon: 'wallet',
    problem:
      'Selisih kas di gerai cabang dan rekonsiliasi mutasi rekening koran bank memakan waktu berhari-hari.',
    solution:
      'Loket kasir resmi, cash opname harian, dan modul Ayat Silang pencocokan mutasi bank otomatis.',
    outcomes: [
      'Cetak kuitansi & BSZ resmi seketika',
      'Rekonsiliasi rekening koran selesai hitungan menit',
      'Validasi mutasi QRIS, transfer, & tunai',
    ],
    waMsg:
      'Halo Kriya, saya ingin konsultasi modul Kasir & Rekonsiliasi Bank di Software ZISWAF ERP.',
  },
  {
    domain: 'Pusat Penyetujuan Terpadu (Approval)',
    icon: 'shield-check',
    problem:
      'Permohonan dana (PPD) tertahan di nota kertas atau chat WhatsApp tanpa kejelasan status dan audit trail.',
    solution:
      'Alur otorisasi berjenjang (Manajer ➔ Kadiv ➔ Direktur) dari laptop maupun smartphone secara real-time.',
    outcomes: [
      'Penyetujuan bantuan cepat & transparan',
      'Pencairan kasir terkunci otorisasi sah',
      'Jejak audit digital lengkap 100%',
    ],
    waMsg: 'Halo Kriya, saya ingin konsultasi modul Approval Center & PPD di Software ZISWAF ERP.',
  },
  {
    domain: 'Penyaluran 8 Asnaf & LPJ',
    icon: 'pie-chart',
    problem:
      'Alokasi asnaf sulit dipantau, mustahik terdata ganda, dan kuitansi LPJ fisik lapangan menumpuk tak tuntas.',
    solution:
      'Pengelompokan 5 Pilar & 8 Asnaf, database mustahik NIK terintegrasi, dan validasi LPJ foto/kuitansi digital.',
    outcomes: [
      'Penyaluran tepat 8 Asnaf Syariah',
      'Pencegahan penerima bantuan ganda',
      'Kepatuhan standar rasio ACR BAZNAS',
    ],
    waMsg:
      'Halo Kriya, saya ingin konsultasi modul Penyaluran 8 Asnaf & LPJ di Software ZISWAF ERP.',
  },
  {
    domain: 'Akuntansi Syariah PSAK 109 & RKAT',
    icon: 'calculator',
    problem:
      'Format pembukuan syariah salah rumus di spreadsheet dan pengeluaran kegiatan sering melebihi pagu RKAT.',
    solution:
      'Jurnal otomatis PSAK 109 (pemisahan dana Zakat, Infaq, Wakaf, Amil) dan Budget Control real-time.',
    outcomes: [
      'Buku kas syariah otomatis dari transaksi',
      'Sistem Budget Control cegah overbudget',
      'Laporan keuangan siap audit KAP / WTP',
    ],
    waMsg:
      'Halo Kriya, saya ingin konsultasi modul Akuntansi PSAK 109 & RKAT di Software ZISWAF ERP.',
  },
  {
    domain: 'SDM, Presensi Wajah & Mutabaah',
    icon: 'user-check',
    problem:
      'Presensi amil lapangan rawan titip absen dan pembinaan spiritualitas amil yang menjadi ruh lembaga terabaikan.',
    solution:
      'Presensi kamera deteksi wajah + validasi GPS, Laporan Kerja Harian, KPI, dan evaluasi Mutabaah Yaumiyah.',
    outcomes: [
      'Presensi akurat anti titip absen',
      'Amil terbina ibadah yaumiyahnya',
      'Kanal pelaporan gratifikasi independen',
    ],
    waMsg: 'Halo Kriya, saya ingin konsultasi modul SDM & Mutabaah Amil di Software ZISWAF ERP.',
  },
];
---

<section class="bg-gray-50/50 py-16 sm:py-24 dark:bg-neutral-900/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">

      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
      >
        Jawaban Konkret untuk Setiap Bidang Lembaga
      </h2>
      <p class="mt-3 text-base text-gray-600 dark:text-neutral-400">
        Perbandingan langsung antara hambatan operasional lama dengan solusi cepat yang dihadirkan
        Software ZISWAF ERP.
      </p>
    </div>

    <!-- 6 Concise Cards Grid -->
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        solutionsBrief.map((item, idx) => (
          <div class="flex flex-col justify-between rounded-3xl border border-gray-200 bg-white p-6 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-emerald-500 hover:shadow-xl dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
            <div>
              <div class="flex items-center justify-between border-b border-gray-100 pb-3.5 dark:border-neutral-800">
                <span class="text-xs font-bold tracking-wider text-emerald-700 uppercase dark:text-emerald-400">
                  Bidang {idx + 1}
                </span>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300">
                  <Check class="size-4" />
                </span>
              </div>

              <h3 class="mt-3 text-lg font-bold text-gray-900 dark:text-white">{item.domain}</h3>

              <div class="mt-3 rounded-xl border border-red-100 bg-red-50/50 p-3 dark:border-red-900/30 dark:bg-red-950/20">
                <span class="text-[10px] font-bold tracking-wider text-red-700 uppercase dark:text-red-400">
                  Hambatan:
                </span>
                <p class="mt-0.5 text-xs leading-snug text-red-950 dark:text-red-200">
                  {item.problem}
                </p>
              </div>

              <div class="mt-3 rounded-xl border border-emerald-100 bg-emerald-50/50 p-3 dark:border-emerald-900/30 dark:bg-emerald-950/20">
                <span class="text-[10px] font-bold tracking-wider text-emerald-700 uppercase dark:text-emerald-400">
                  Solusi ERP:
                </span>
                <p class="mt-0.5 text-xs leading-snug font-medium text-emerald-950 dark:text-emerald-200">
                  {item.solution}
                </p>
              </div>

              <div class="mt-4">
                <span class="text-[10px] font-bold tracking-wider text-gray-400 uppercase dark:text-neutral-500">
                  Hasil Langsung:
                </span>
                <ul class="mt-1.5 space-y-1.5">
                  {item.outcomes.map((out) => (
                    <li class="flex items-start gap-2 text-xs text-gray-700 dark:text-neutral-300">
                      <Check class="mt-0.5 size-3.5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-400" />
                      <span>{out}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-5 border-t border-gray-100 pt-3 dark:border-neutral-800">
              <a
                href={getWaUrl(item.waMsg)}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-between text-xs font-semibold text-emerald-700 hover:text-emerald-600 dark:text-emerald-400 dark:hover:text-emerald-300"
              >
                <span>Konsultasi Bidang Ini</span>
                <ArrowRight class="size-3.5" />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
