---
interface Props {
  comparison: {
    headline: string;
    columns: string[];
    rows: Array<{
      feature: string;
      manual: string;
      ordinary: string;
      erp: string;
    }>;
  };
}

const { comparison } = Astro.props;
---

<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">

      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
      >
        {comparison.headline}
      </h2>
      <p class="mt-4 text-base text-gray-600 dark:text-neutral-300">
        Lihat bagaimana Software ZISWAF ERP menaikkan standar tata kelola lembaga Anda ke tingkat
        Enterprise Resource Planning.
      </p>
    </div>

    <!-- Table Container with Horizontal Scroll for Mobile -->
    <div
      class="mt-12 overflow-x-auto rounded-3xl border border-gray-200 bg-white shadow-xl dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)"
    >
      <table class="w-full min-w-[700px] border-collapse text-left text-sm">
        <thead>
          <tr
            class="border-b border-gray-100 bg-gray-50/80 dark:border-neutral-800 dark:bg-neutral-900/60"
          >
            <th class="w-1/4 px-6 py-4 font-bold text-gray-900 dark:text-white">
              {comparison.columns[0]}
            </th>
            <th class="w-1/4 px-6 py-4 font-semibold text-gray-600 dark:text-neutral-400">
              {comparison.columns[1]}
            </th>
            <th class="w-1/4 px-6 py-4 font-semibold text-gray-600 dark:text-neutral-400">
              {comparison.columns[2]}
            </th>
            <th
              class="w-1/4 border-l border-emerald-500/20 bg-emerald-500/10 px-6 py-4 font-bold text-emerald-700 dark:text-emerald-300"
            >
              <div class="flex items-center justify-between">
                <span>{comparison.columns[3]}</span>
                <span
                  class="rounded-full bg-emerald-600 px-2.5 py-0.5 text-[10px] font-bold tracking-wider text-white uppercase"
                >
                  Terpadu
                </span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-neutral-800">
          {
            comparison.rows.map((row, idx) => (
              <tr class={idx % 2 === 0 ? 'bg-transparent' : 'bg-gray-50/30 dark:bg-neutral-900/20'}>
                <td class="px-6 py-4 font-bold text-gray-900 dark:text-white">{row.feature}</td>
                <td class="px-6 py-4 text-gray-600 dark:text-neutral-400">
                  <div class="flex items-start gap-2">
                    <span class="mt-0.5 shrink-0 text-red-500">✕</span>
                    <span>{row.manual}</span>
                  </div>
                </td>
                <td class="px-6 py-4 text-gray-600 dark:text-neutral-400">
                  <div class="flex items-start gap-2">
                    <span class="mt-0.5 shrink-0 text-amber-500">⚠️</span>
                    <span>{row.ordinary}</span>
                  </div>
                </td>
                <td class="border-l border-emerald-500/20 bg-emerald-500/5 px-6 py-4 font-semibold text-gray-900 dark:text-emerald-200">
                  <div class="flex items-start gap-2">
                    <span class="mt-0.5 shrink-0 font-bold text-emerald-600 dark:text-emerald-400">
                      ✓
                    </span>
                    <span>{row.erp}</span>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
