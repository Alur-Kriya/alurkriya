---
import { Check } from '@lucide/astro';

interface Props {
  roles: Array<{
    id: string;
    role: string;
    summary: string;
    benefits: string[];
  }>;
}

const { roles } = Astro.props;
---

<section class="bg-gray-50/70 py-16 sm:py-24 dark:bg-neutral-900/40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">

      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
      >
        Manfaat Nyata untuk Seluruh Tim Lembaga Anda
      </h2>
      <p class="mt-4 text-base text-gray-600 sm:text-lg dark:text-neutral-300">
        Dari pimpinan puncak yang membutuhkan ringkasan eksekutif, hingga amil lapangan yang
        mencatat kuitansi donasi.
      </p>
    </div>

    <!-- Role Cards Grid -->
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        roles.map((r, idx) => (
          <div
            class={`flex flex-col justify-between rounded-3xl border bg-white p-6 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:shadow-xl sm:p-8 dark:bg-(--color-deep-space-blue-950) ${
              idx === 0
                ? 'border-emerald-300/80 ring-2 ring-emerald-500/20 dark:border-emerald-800'
                : 'border-gray-200 dark:border-neutral-800'
            }`}
          >
            <div>
              <div class="flex items-center justify-between border-b border-gray-100 pb-4 dark:border-neutral-800">
                <span class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
                  Peran {idx + 1}
                </span>
                {idx === 0 && (
                  <span class="text-[10px] font-bold tracking-wider text-emerald-600 uppercase dark:text-emerald-400">
                    Eksekutif
                  </span>
                )}
              </div>

              <h3 class="mt-4 text-lg font-bold text-gray-900 dark:text-white">{r.role}</h3>

              <p class="mt-2 text-xs leading-relaxed text-gray-600 dark:text-neutral-400">
                {r.summary}
              </p>

              <div class="mt-6 border-t border-gray-100 pt-4 dark:border-neutral-800">
                <h4 class="text-[11px] font-bold tracking-wider text-gray-400 uppercase dark:text-neutral-500">
                  Dampak Langsung:
                </h4>
                <ul class="mt-3 space-y-2.5">
                  {r.benefits.map((b) => (
                    <li class="flex items-start gap-2 text-xs font-medium text-gray-700 dark:text-neutral-300">
                      <Check class="mt-0.5 size-3.5 shrink-0 stroke-[3] text-emerald-600 dark:text-emerald-400" />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
