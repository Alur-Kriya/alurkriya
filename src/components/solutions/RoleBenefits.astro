---
import { Check, ArrowRight, ShieldCheck } from '@lucide/astro';
import { getWaUrl } from '@lib/whatsapp';

interface Props {
  headline?: string;
  subheadline?: string;
  roles: Array<{
    id: string;
    role: string;
    summary: string;
    benefits: string[];
  }>;
}

const {
  headline = 'Manfaat Nyata untuk Seluruh Tim Lembaga Anda',
  subheadline = 'Bukan sekadar fitur umum, sistem dirancang presisi memberikan kemudahan kerja spesifik bagi setiap divisi organisasi.',
  roles = [],
} = Astro.props;
---

<section
  id="manfaat-peran"
  class="scroll-mt-20 bg-gradient-to-b from-white via-gray-50/60 to-white py-16 sm:py-24 dark:from-(--color-deep-space-blue-900) dark:via-neutral-900/40 dark:to-(--color-deep-space-blue-950)"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200/80 bg-emerald-50/70 px-3.5 py-1 text-xs font-semibold text-emerald-800 backdrop-blur-xs dark:border-emerald-800/60 dark:bg-emerald-950/40 dark:text-emerald-300"
      >
        <ShieldCheck class="size-3.5 text-emerald-600 dark:text-emerald-400" />
        Dirancang Spesifik per Bidang Tanggung Jawab
      </span>

      <h2
        class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl dark:text-white"
      >
        {headline}
      </h2>
      <p class="mt-4 text-base text-gray-600 sm:text-lg dark:text-neutral-300">
        {subheadline}
      </p>
    </div>

    <!-- Role Tab Selector -->
    <div
      class="mt-12 flex flex-wrap items-center justify-center gap-2 sm:gap-3"
      id="role-tabs-nav"
      role="tablist"
      aria-label="Pilihan Peran dan Stakeholder Organisasi"
    >
      {
        roles.map((r, idx) => (
          <button
            type="button"
            role="tab"
            id={`role-tab-${r.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`role-panel-${r.id}`}
            class={`role-tab-btn inline-flex min-h-[44px] items-center gap-2 rounded-2xl border px-4 py-2.5 text-xs font-semibold transition-all duration-200 focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:outline-hidden sm:text-sm ${
              idx === 0
                ? 'active border-emerald-500 bg-emerald-600 text-white shadow-md shadow-emerald-600/20'
                : 'border-gray-200 bg-white text-gray-700 shadow-2xs hover:border-emerald-400 hover:bg-emerald-50/60 hover:text-emerald-700 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:border-emerald-500 dark:hover:bg-neutral-700'
            }`}
            data-role-target={r.id}
          >
            <span class="inline-block size-2 rounded-full bg-current opacity-80" />
            <span>{r.role}</span>
          </button>
        ))
      }
    </div>

    <!-- Role Panels Container -->
    <div class="mt-10" id="role-panels-container">
      {
        roles.map((r, idx) => (
          <div
            id={`role-panel-${r.id}`}
            role="tabpanel"
            aria-labelledby={`role-tab-${r.id}`}
            class={`role-panel transition-opacity duration-300 ${idx === 0 ? 'block opacity-100' : 'hidden opacity-0'}`}
          >
            <div class="grid items-center gap-8 rounded-3xl border border-gray-200/90 bg-white p-6 shadow-xl lg:grid-cols-12 lg:gap-12 lg:p-10 dark:border-neutral-800 dark:bg-(--color-deep-space-blue-950)">
              {/* Left Column: Role Details & Benefits (5 cols) */}
              <div class="flex flex-col justify-between lg:col-span-5">
                <div>
                  <div class="inline-flex items-center gap-2 rounded-lg bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
                    <span>Fokus: {r.role}</span>
                  </div>

                  <h3 class="mt-4 text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl dark:text-white">
                    {r.role}
                  </h3>

                  <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-neutral-300">
                    {r.summary}
                  </p>

                  <div class="mt-6 border-t border-gray-100 pt-5 dark:border-neutral-800">
                    <h4 class="text-xs font-bold tracking-wider text-gray-400 uppercase dark:text-neutral-500">
                      Keunggulan & Dampak Langsung:
                    </h4>
                    <ul class="mt-3.5 space-y-3">
                      {r.benefits.map((b) => (
                        <li class="flex items-start gap-3 rounded-xl border border-gray-100/80 bg-gray-50/50 p-2.5 text-xs font-medium text-gray-800 dark:border-neutral-800/80 dark:bg-neutral-900/40 dark:text-neutral-200">
                          <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-400">
                            <Check class="size-3 stroke-[3]" />
                          </span>
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="mt-8 border-t border-gray-100 pt-5 dark:border-neutral-800">
                  <a
                    href={getWaUrl(
                      `Halo Kriya, saya ingin konsultasi sistem untuk kebutuhan ${r.role}.`
                    )}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-[44px] items-center gap-2 rounded-xl bg-(--color-steel-blue-800) px-5 py-2.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-(--color-steel-blue-700) focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:bg-(--color-steel-blue-700) dark:hover:bg-(--color-steel-blue-600)"
                    data-analytics-cta="whatsapp"
                    data-analytics-location="role_benefits"
                  >
                    <span>Konsultasi Kebutuhan {r.role.split('&')[0].trim()}</span>
                    <ArrowRight class="size-3.5" />
                  </a>
                </div>
              </div>

              {/* Right Column: Bespoke Live UI Mockup Preview (7 cols) */}
              <div class="lg:col-span-7">
                <div class="overflow-hidden rounded-2xl border border-gray-200/80 bg-gray-900 shadow-2xl dark:border-neutral-700">
                  {/* Browser / App Header Bar */}
                  <div class="flex items-center justify-between border-b border-gray-800 bg-gray-950/80 px-4 py-3">
                    <div class="flex items-center gap-1.5">
                      <span class="size-2.5 rounded-full bg-red-500/80" />
                      <span class="size-2.5 rounded-full bg-amber-500/80" />
                      <span class="size-2.5 rounded-full bg-emerald-500/80" />
                    </div>
                    <div class="rounded-md bg-gray-800/60 px-3 py-0.5 text-[11px] font-medium text-gray-300">
                      Simulasi Pemantauan: {r.role.split('&')[0].trim()}
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="inline-block size-2 rounded-full bg-amber-400" />
                      <span class="text-[10px] font-semibold text-amber-300">
                        Contoh Simulasi Tampilan
                      </span>
                    </div>
                  </div>

                  {/* Mockup Content Canvas tailored per role */}
                  <div class="p-5 font-sans text-white sm:p-6">
                    {r.id === 'direktur' && (
                      <div class="space-y-4">
                        <div class="flex items-center justify-between border-b border-gray-800 pb-3">
                          <div>
                            <span class="text-xs text-gray-400">Ringkasan Eksekutif Yayasan</span>
                            <h5 class="text-lg font-bold text-white">
                              Executive Command Dashboard
                            </h5>
                          </div>
                          <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-400">
                            Status: Siap Audit WTP
                          </span>
                        </div>

                        {/* 3 Stat Widgets */}
                        <div class="grid grid-cols-3 gap-3">
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">
                              Total Himpunan (YTD)
                            </span>
                            <span class="text-base font-extrabold text-emerald-400">
                              Rp 4.280.500.000
                            </span>
                            <span class="mt-0.5 block text-[9px] text-emerald-500">
                              ▲ +24.8% vs tahun lalu
                            </span>
                          </div>
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">Rasio Kepatuhan ACR</span>
                            <span class="text-base font-extrabold text-blue-400">89.4%</span>
                            <span class="mt-0.5 block text-[9px] text-gray-400">
                              Standar BAZNAS (Aman)
                            </span>
                          </div>
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">Serapan Pagu RKAT</span>
                            <span class="text-base font-extrabold text-amber-400">68.2%</span>
                            <span class="mt-0.5 block text-[9px] text-amber-500">
                              Budget Alert: Normal
                            </span>
                          </div>
                        </div>

                        {/* Action Center Queue */}
                        <div class="rounded-xl border border-emerald-500/20 bg-emerald-950/20 p-3.5">
                          <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-emerald-300">
                              Action Center: 1 Otorisasi Dana Menunggu Persetujuan Direktur
                            </span>
                            <span class="rounded bg-emerald-600 px-2 py-0.5 text-[10px] font-bold text-white">
                              Segera
                            </span>
                          </div>
                          <div class="mt-2.5 flex items-center justify-between rounded-lg border border-gray-800 bg-gray-900/80 p-2.5 text-xs">
                            <div>
                              <p class="font-bold text-white">
                                PPD-2026-042: Bantuan Darurat Bencana Banjir (Fakir/Miskin)
                              </p>
                              <p class="text-[10px] text-gray-400">
                                Diajukan: Div. Program Lapangan • Nominal: Rp 35.000.000
                              </p>
                            </div>
                            <span class="rounded-md bg-emerald-600 px-3 py-1 text-xs font-bold text-white">
                              ✓ Setujui
                            </span>
                          </div>
                        </div>
                      </div>
                    )}

                    {r.id === 'keuangan' && (
                      <div class="space-y-4">
                        <div class="flex items-center justify-between border-b border-gray-800 pb-3">
                          <div>
                            <span class="text-xs text-gray-400">Standar Akuntansi Syariah</span>
                            <h5 class="text-lg font-bold text-white">
                              Buku Besar & Jurnal Otomatis PSAK 109
                            </h5>
                          </div>
                          <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-400">
                            Rekonsiliasi: 100% Klop
                          </span>
                        </div>

                        <div class="grid grid-cols-4 gap-2 text-center text-xs">
                          <div class="rounded-lg border border-gray-800 bg-gray-800/40 p-2">
                            <span class="block text-[10px] text-gray-400">
                              Dana Zakat (8 Asnaf)
                            </span>
                            <span class="font-bold text-emerald-400">Rp 1,84 M</span>
                          </div>
                          <div class="rounded-lg border border-gray-800 bg-gray-800/40 p-2">
                            <span class="block text-[10px] text-gray-400">
                              Dana Infaq / Sedekah
                            </span>
                            <span class="font-bold text-blue-400">Rp 1,42 M</span>
                          </div>
                          <div class="rounded-lg border border-gray-800 bg-gray-800/40 p-2">
                            <span class="block text-[10px] text-gray-400">Dana Wakaf Terikat</span>
                            <span class="font-bold text-purple-400">Rp 650 Jt</span>
                          </div>
                          <div class="rounded-lg border border-gray-800 bg-gray-800/40 p-2">
                            <span class="block text-[10px] text-gray-400">
                              Hak Kelola Amil (1/8)
                            </span>
                            <span class="font-bold text-amber-400">11.8% (Sesuai)</span>
                          </div>
                        </div>

                        <div class="space-y-2 rounded-xl border border-gray-800 bg-gray-800/30 p-3 text-xs">
                          <div class="flex items-center justify-between border-b border-gray-800/60 pb-1.5 text-[11px] text-gray-400">
                            <span>Modul Ayat Silang Bank (Mutasi Rekening Koran)</span>
                            <span class="text-emerald-400">Match 142 Transaksi Hari Ini</span>
                          </div>
                          <div class="flex items-center justify-between text-[11px]">
                            <span class="text-gray-300">Bank Syariah Indonesia (BSI) 7001-xxx</span>
                            <span class="font-mono text-emerald-400">Klop Rp 84.500.000 ✓</span>
                          </div>
                          <div class="flex items-center justify-between text-[11px]">
                            <span class="text-gray-300">Bank Muamalat 101-xxx</span>
                            <span class="font-mono text-emerald-400">Klop Rp 42.100.000 ✓</span>
                          </div>
                        </div>
                      </div>
                    )}

                    {r.id === 'fundraising' && (
                      <div class="space-y-4">
                        <div class="flex items-center justify-between border-b border-gray-800 pb-3">
                          <div>
                            <span class="text-xs text-gray-400">Relationship Management (CRM)</span>
                            <h5 class="text-lg font-bold text-white">
                              Database Muzaki 360° & Otomasi WA
                            </h5>
                          </div>
                          <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-400">
                            Retensi: 82.4%
                          </span>
                        </div>

                        <div class="grid grid-cols-3 gap-3 text-xs">
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">
                              Total Muzaki Terdaftar
                            </span>
                            <span class="text-base font-extrabold text-white">14.820 Muzaki</span>
                          </div>
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">
                              Schedule Donasi Rutin
                            </span>
                            <span class="text-base font-extrabold text-emerald-400">
                              1.240 Komitmen
                            </span>
                          </div>
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">
                              Pipeline Telemarketing
                            </span>
                            <span class="text-base font-extrabold text-blue-400">
                              86 Kontak Hari Ini
                            </span>
                          </div>
                        </div>

                        <div class="rounded-xl border border-emerald-500/20 bg-gray-900/90 p-3 text-xs">
                          <div class="flex items-center justify-between text-[11px] font-bold text-emerald-300">
                            <span>WhatsApp Campaign Manager Auto-Dispatcher</span>
                            <span class="text-emerald-400">Status: Sent 100%</span>
                          </div>
                          <p class="mt-1 text-[11px] text-gray-300">
                            "Jazakallahu khair Bapak Irwan, bukti setor Zakat Penghasilan No.
                            BSZ-2026-088 telah terbit resmi dan dana disalurkan ke Program Peduli
                            Yatim."
                          </p>
                        </div>
                      </div>
                    )}

                    {r.id === 'program' && (
                      <div class="space-y-4">
                        <div class="flex items-center justify-between border-b border-gray-800 pb-3">
                          <div>
                            <span class="text-xs text-gray-400">Pemberdayaan & Pendayagunaan</span>
                            <h5 class="text-lg font-bold text-white">
                              Monitoring Penyaluran 8 Asnaf & LPJ
                            </h5>
                          </div>
                          <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-400">
                            Penyaluran: Tepat Sasaran
                          </span>
                        </div>

                        {/* 8 Asnaf Progress Bar */}
                        <div class="rounded-xl border border-gray-800 bg-gray-800/30 p-3">
                          <span class="block text-[10px] text-gray-400">
                            Peta Alokasi 8 Asnaf Zakat:
                          </span>
                          <div class="mt-2 flex h-3 overflow-hidden rounded-full bg-gray-700">
                            <div style="width: 40%" class="bg-emerald-500" title="Fakir (40%)" />
                            <div style="width: 35%" class="bg-teal-400" title="Miskin (35%)" />
                            <div
                              style="width: 12%"
                              class="bg-blue-400"
                              title="Fisabilillah (12%)"
                            />
                            <div style="width: 8%" class="bg-amber-400" title="Ibnu Sabil (8%)" />
                            <div style="width: 5%" class="bg-purple-400" title="Muallaf (5%)" />
                          </div>
                          <div class="mt-2 flex justify-between text-[10px] text-gray-400">
                            <span>Fakir (40%)</span>
                            <span>Miskin (35%)</span>
                            <span>Fisabilillah (12%)</span>
                            <span>Lainnya (13%)</span>
                          </div>
                        </div>

                        <div class="flex items-center justify-between rounded-xl border border-gray-800 bg-gray-900 p-3 text-xs">
                          <div>
                            <p class="font-bold text-white">
                              Validasi LPJ Mustahik Lapangan (Anti-Duplikasi NIK)
                            </p>
                            <p class="text-[10px] text-gray-400">
                              Foto dokumentasi serah terima & koordinat GPS tervalidasi
                            </p>
                          </div>
                          <span class="rounded-md border border-emerald-500/30 bg-emerald-500/20 px-2.5 py-1 font-mono text-xs text-emerald-400">
                            ✓ Terverifikasi
                          </span>
                        </div>
                      </div>
                    )}

                    {r.id === 'sdm' && (
                      <div class="space-y-4">
                        <div class="flex items-center justify-between border-b border-gray-800 pb-3">
                          <div>
                            <span class="text-xs text-gray-400">
                              Tata Kelola Kepegawaian & Spiritualitas
                            </span>
                            <h5 class="text-lg font-bold text-white">
                              Presensi Wajah GPS & Mutabaah Yaumiyah
                            </h5>
                          </div>
                          <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-400">
                            Integritas: Terjaga
                          </span>
                        </div>

                        <div class="grid grid-cols-3 gap-3 text-xs">
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">
                              Presensi Wajah & GPS
                            </span>
                            <span class="text-sm font-bold text-emerald-400">
                              07:54 WIB (Valid)
                            </span>
                            <span class="mt-0.5 block text-[9px] text-gray-400">
                              Radius Kantor Cabang
                            </span>
                          </div>
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">Mutabaah Yaumiyah</span>
                            <span class="text-sm font-bold text-blue-400">Skor 96%</span>
                            <span class="mt-0.5 block text-[9px] text-gray-400">
                              Sholat Berjamaah, Tilawah
                            </span>
                          </div>
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">Kanal Gratifikasi</span>
                            <span class="text-sm font-bold text-purple-400">0 Laporan Fraud</span>
                            <span class="mt-0.5 block text-[9px] text-gray-400">
                              Kepatuhan Amanah 100%
                            </span>
                          </div>
                        </div>

                        <div class="rounded-xl border border-gray-800 bg-gray-900 p-3 text-xs">
                          <p class="font-bold text-white">
                            Laporan Kerja Harian (LKH) & Otorisasi SPPD Terpadu
                          </p>
                          <p class="mt-1 text-[11px] text-gray-300">
                            Pengajuan cuti, jam lembur, dan dinas luar kota tersinkronisasi otomatis
                            ke dashboard tanpa formulir kertas.
                          </p>
                        </div>
                      </div>
                    )}

                    {r.id === 'sme-owner' && (
                      <div class="space-y-4">
                        <div class="flex items-center justify-between border-b border-gray-800 pb-3">
                          <div>
                            <span class="text-xs text-gray-400">
                              Infrastruktur Kantor UKM & Ruko
                            </span>
                            <h5 class="text-lg font-bold text-white">
                              Gateway Router & Bandwidth Shaper QoS
                            </h5>
                          </div>
                          <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-400">
                            Standar Backbone: Gigabit
                          </span>
                        </div>

                        <div class="grid grid-cols-3 gap-3 text-xs">
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">
                              Kasir POS & ERP Cloud
                            </span>
                            <span class="text-sm font-bold text-emerald-400">
                              Prioritas Tinggi (QoS)
                            </span>
                            <span class="mt-0.5 block text-[9px] text-emerald-500">
                              Trafik Kritis Diprioritaskan
                            </span>
                          </div>
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">
                              Jaringan Tamu (VLAN)
                            </span>
                            <span class="text-sm font-bold text-blue-400">Terisolasi Aman</span>
                            <span class="mt-0.5 block text-[9px] text-gray-400">
                              Subnet Terpisah dari Server
                            </span>
                          </div>
                          <div class="rounded-xl border border-gray-800 bg-gray-800/40 p-3">
                            <span class="block text-[10px] text-gray-400">
                              Konektivitas Lantai 1-3
                            </span>
                            <span class="text-sm font-bold text-purple-400">
                              Fast Roaming Aktif
                            </span>
                            <span class="mt-0.5 block text-[9px] text-gray-400">
                              802.11k/v/r Handover
                            </span>
                          </div>
                        </div>

                        <div class="flex items-center justify-between rounded-xl border border-emerald-500/20 bg-gray-900 p-3 text-xs">
                          <div>
                            <p class="font-bold text-white">Multi-WAN Failover Siap Otomatis</p>
                            <p class="text-[10px] text-gray-400">
                              Bila ISP Utama gangguan, router otomatis mengalihkan koneksi ke ISP
                              Cadangan untuk menjaga kontinuitas operasional kantor.
                            </p>
                          </div>
                          <span class="rounded bg-emerald-600 px-2 py-1 text-[11px] font-bold text-white">
                            Standby
                          </span>
                        </div>
                      </div>
                    )}

