</section>

<script>
  function initRoleTabs() {
    const nav = document.getElementById('role-tabs-nav');
    const container = document.getElementById('role-panels-container');
    if (!nav || !container) return;

    const btns = Array.from(nav.querySelectorAll<HTMLButtonElement>('.role-tab-btn'));
    const panels = Array.from(container.querySelectorAll<HTMLElement>('.role-panel'));

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-role-target');

        // Update Button States
        btns.forEach((b) => {
          b.classList.remove(
            'active',
            'border-emerald-500',
            'bg-emerald-600',
            'text-white',
            'shadow-md',
            'shadow-emerald-600/20'
          );
          b.classList.add(
            'border-gray-200',
            'bg-white',
            'text-gray-700',
            'dark:border-neutral-700',
            'dark:bg-neutral-800',
            'dark:text-neutral-300'
          );
        });

        btn.classList.add(
          'active',
          'border-emerald-500',
          'bg-emerald-600',
          'text-white',
          'shadow-md',
          'shadow-emerald-600/20'
        );
        btn.classList.remove(
          'border-gray-200',
          'bg-white',
          'text-gray-700',
          'dark:border-neutral-700',
          'dark:bg-neutral-800',
          'dark:text-neutral-300'
        );

        // Update Panel States
        panels.forEach((p) => {
          if (p.id === `role-panel-${targetId}`) {
            p.classList.remove('hidden');
            setTimeout(() => {
              p.classList.remove('opacity-0');
              p.classList.add('opacity-100');
            }, 10);
          } else {
            p.classList.add('hidden', 'opacity-0');
            p.classList.remove('opacity-100');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRoleTabs);
  } else {
    initRoleTabs();
  }
  document.addEventListener('astro:page-load', initRoleTabs);
</script>
