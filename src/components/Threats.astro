---
import { CircleCheck } from '@lucide/astro';
---

<!-- Icon Blocks -->
<div class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 lg:px-8 lg:py-20">
  <!-- Grid -->
  <div class="grid gap-12 md:grid-cols-2">
    <div class="lg:w-3/4">
      <h2 class="text-3xl font-bold text-(--color-ink-black-800) lg:text-4xl dark:text-white">
        Menjawab Tantangan Transformasi Digital Bisnis
      </h2>
      <p class="mt-3 dark:text-neutral-300">
        Banyak perusahaan menghadapi kompleksitas teknologi yang terus berkembang, mulai dari sistem
        yang tidak terintegrasi, keterbatasan skalabilitas, hingga risiko keamanan data.
      </p>
      <p class="mt-5">
        <a
          class="inline-flex min-h-[44px] items-center gap-x-1.5 rounded-md py-2 text-sm font-semibold text-(--color-steel-blue-800) decoration-2 hover:underline focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:ring-offset-2 focus-visible:outline-hidden dark:text-(--color-steel-blue-300) dark:focus-visible:ring-offset-neutral-900"
          href="/kontak"
        >
          Diskusikan Tantangan Teknologi Anda
        </a>
      </p>
    </div>
    <!-- End Col -->

    <div class="space-y-6 lg:space-y-10">
      <!-- Icon Block -->
      <div class="flex gap-x-5 sm:gap-x-8">
        <div>
          <CircleCheck class="mt-2 size-8 shrink-0 text-(--color-ink-black-800) dark:text-white" />
        </div>
        <div class="grow">
          <h3
            class="text-base font-semibold text-(--color-ink-black-800) sm:text-lg dark:text-white"
          >
            Fragmentasi Sistem & Proses
          </h3>
          <p class="mt-1 dark:text-neutral-300">
            Banyak organisasi masih bergantung pada sistem yang terpisah dan tidak saling
            terintegrasi, menyebabkan inefisiensi, duplikasi data, dan pengambilan keputusan yang
            lambat.
          </p>
        </div>
      </div>
      <!-- End Icon Block -->

      <!-- Icon Block -->
      <div class="flex gap-x-5 sm:gap-x-8">
        <div>
          <CircleCheck class="mt-2 size-8 shrink-0 text-(--color-ink-black-800) dark:text-white" />
        </div>
        <div class="grow">
          <h3
            class="text-base font-semibold text-(--color-ink-black-800) sm:text-lg dark:text-white"
          >
            Keterbatasan Infrastruktur & Skalabilitas
          </h3>
          <p class="mt-1 dark:text-neutral-300">
            Infrastruktur lama sering kali tidak mampu mengikuti pertumbuhan bisnis, meningkatkan
            biaya operasional dan risiko downtime.
          </p>
        </div>
      </div>
      <!-- End Icon Block -->

      <!-- Icon Block -->
      <div class="flex gap-x-5 sm:gap-x-8">
        <div>
          <CircleCheck class="mt-2 size-8 shrink-0 text-(--color-ink-black-800) dark:text-white" />
        </div>
        <div class="grow">
          <h3
            class="text-base font-semibold text-(--color-ink-black-800) sm:text-lg dark:text-white"
          >
            Risiko Keamanan & Tata Kelola Data
          </h3>
          <p class="mt-1 dark:text-neutral-300">
            Transformasi digital tanpa fondasi keamanan yang kuat dapat membuka celah terhadap
            kebocoran data, pelanggaran kepatuhan, dan gangguan operasional.
          </p>
        </div>
      </div>
      <!-- End Icon Block -->
    </div>
    <!-- End Col -->
  </div>
  <!-- End Grid -->
</div>
<!-- End Icon Blocks -->
