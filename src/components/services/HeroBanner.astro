---
import { Picture } from 'astro:assets';
import Wabutton from '@components/ui/Wabutton.astro';

interface Props {
  heading: string;
  description: string;
  images: any;
}

const { heading, description, images } = Astro.props;
---

<!-- Hero -->
<div class="mx-auto max-w-[85rem] px-4 py-30 sm:px-6 lg:px-8">
  <!-- Grid -->
  <div class="grid lg:grid-cols-7 lg:items-center lg:gap-x-8 xl:gap-x-12">
    <div class="lg:col-span-3">
      <h1
        class="block text-3xl font-bold text-gray-800 sm:text-4xl md:text-5xl lg:text-6xl dark:text-white"
      >
        <span class="text-(--color-fresh-sky-500) dark:text-(--color-fresh-sky-500)"
          >{heading}</span
        >
      </h1>
      <p class="mt-3 text-lg text-gray-800 dark:text-neutral-400">
        {description}
      </p>

      <!-- Buttons -->
      <div class="mt-7 grid w-full gap-3 sm:inline-flex">
        <Wabutton />
      </div>
      <!-- End Buttons -->

    </div>
    <!-- End Col -->

    <div class="mt-10 lg:col-span-4 lg:mt-0">
      {
        (
          <Picture
            src={images}
            alt={`Jasa ${heading} - PT Alur Kriya Teknologi`}
            class="w-full rounded-xl object-cover"
            draggable="false"
            loading="eager"
            decoding="async" 
            formats={['avif', 'webp']}
            priority
          />
        )
      }
    </div>
    <!-- End Col -->
  </div>
  <!-- End Grid -->
</div>
<!-- End Hero -->
