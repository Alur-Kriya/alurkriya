---
import { Phone, Mail, MapPin } from '@lucide/astro';
---

<!-- Contact Us -->
<div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:gap-16">
      <!-- Info -->
      <div class="flex flex-col gap-y-6 sm:gap-y-10">
        <div class="flex items-center gap-x-4">
          <div
            class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-200"
          >
            <Phone class="size-6" />
          </div>
          <div>
            <h3 class="font-medium text-gray-800 dark:text-neutral-200">Telepon / WhatsApp</h3>
            <p class="mt-1 text-sm text-gray-600 dark:text-neutral-400">
              <a
                href="https://wa.me/6285117428800"
                class="text-blue-600 hover:underline dark:text-blue-500">0851 1742 8800</a
              >
            </p>
          </div>
        </div>

        <div class="flex items-center gap-x-4">
          <div
            class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-200"
          >
            <Mail class="size-6" />
          </div>
          <div>
            <h3 class="font-medium text-gray-800 dark:text-neutral-200">Email</h3>
            <p class="mt-1 text-sm text-gray-600 dark:text-neutral-400">
              <a
                href="mailto:info@kriya.click"
                class="text-blue-600 hover:underline dark:text-blue-500">sarah@kriya.click</a
              >
            </p>
          </div>
        </div>

        <div class="flex items-center gap-x-4">
          <div
            class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-200"
          >
            <MapPin class="size-6" />
          </div>
          <div>
            <h3 class="font-medium text-gray-800 dark:text-neutral-200">Alamat Kantor</h3>
            <p class="mt-1 text-sm text-gray-600 dark:text-neutral-400">
              PT. Alur Kriya Teknologi<br />
              Sunter Kemayoran NO.22 RT.001/003<br />
              Tanjung Priok - Jakarta Utara 14350
            </p>
          </div>
        </div>
      </div>
      <!-- End Info -->

      <!-- Form -->
      <div
        class="flex flex-col rounded-xl border border-gray-200 bg-white p-4 sm:p-6 lg:p-8 dark:border-neutral-700 dark:bg-neutral-900/40"
      >
        <h2 class="mb-6 text-xl font-bold text-gray-900 dark:text-neutral-100">
          Kirim Pesan Konsultasi
        </h2>

        <!-- Alert Notification Box -->
        <div id="contact-alert" class="mb-4 hidden rounded-lg p-4 text-sm" role="alert"></div>

        <form id="contact-form" novalidate>
          <div class="grid gap-4">
            <!-- Grid -->
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label
                  for="hs-firstname-contacts-1"
                  class="mb-1 block text-xs font-semibold text-gray-700 dark:text-neutral-300"
                >
                  Nama Depan <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  name="firstname"
                  id="hs-firstname-contacts-1"
                  required
                  class="block w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm focus:outline-hidden focus-visible:border-transparent focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:placeholder-neutral-500"
                  placeholder="Nama Depan"
                />
              </div>

              <div>
                <label
                  for="hs-lastname-contacts-1"
                  class="mb-1 block text-xs font-semibold text-gray-700 dark:text-neutral-300"
                >
                  Nama Belakang
                </label>
                <input
                  type="text"
                  name="lastname"
                  id="hs-lastname-contacts-1"
                  class="block w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm focus:outline-hidden focus-visible:border-transparent focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:placeholder-neutral-500"
                  placeholder="Nama Belakang"
                />
              </div>
            </div>
            <!-- End Grid -->

            <div>
              <label
                for="hs-email-contacts-1"
                class="mb-1 block text-xs font-semibold text-gray-700 dark:text-neutral-300"
              >
                Email Perusahaan / Pribadi <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                name="email"
                id="hs-email-contacts-1"
                required
                autocomplete="email"
                class="block w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm focus:outline-hidden focus-visible:border-transparent focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:placeholder-neutral-500"
                placeholder="nama@perusahaan.com"
              />
            </div>

            <div>
              <label
                for="hs-phone-number-1"
                class="mb-1 block text-xs font-semibold text-gray-700 dark:text-neutral-300"
              >
                No. Telepon / WhatsApp <span class="text-red-500">*</span>
              </label>
              <input
                type="tel"
                name="phone"
                id="hs-phone-number-1"
                required
                class="block w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm focus:outline-hidden focus-visible:border-transparent focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:placeholder-neutral-500"
                placeholder="0812xxxxxxxx"
              />
            </div>

            <div>
              <label
                for="hs-about-contacts-1"
                class="mb-1 block text-xs font-semibold text-gray-700 dark:text-neutral-300"
              >
                Kebutuhan &amp; Pesan Anda <span class="text-red-500">*</span>
              </label>
              <textarea
                id="hs-about-contacts-1"
                name="message"
                rows="4"
                required
                class="block w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm focus:outline-hidden focus-visible:border-transparent focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:placeholder-neutral-500"
                placeholder="Jelaskan kebutuhan solusi IT, proyek pengembangan, atau konsultasi yang Anda perlukan..."
              ></textarea>
            </div>
          </div>
          <!-- End Grid -->

          <div class="mt-5 grid">
            <button
              type="submit"
              id="submit-btn"
              class="inline-flex min-h-[44px] w-full items-center justify-center gap-x-2 rounded-xl bg-(--color-steel-blue-800) px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-(--color-steel-blue-700) focus:outline-hidden focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-60 dark:bg-(--color-steel-blue-700) dark:hover:bg-(--color-steel-blue-600)"
            >
              <span id="btn-text">Kirim Pesan</span>
              <span
                id="btn-spinner"
                class="hidden size-4 animate-spin rounded-full border-2 border-white border-t-transparent"
              ></span>
            </button>
          </div>

          <div class="mt-4 text-center">
            <p class="text-xs text-gray-500 dark:text-neutral-400">
              Tim Kriya akan merespons dalam 1x24 jam kerja.
            </p>
          </div>
        </form>

        <script>
          const form = document.getElementById('contact-form') as HTMLFormElement | null;
          const alertBox = document.getElementById('contact-alert');
          const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
          const btnText = document.getElementById('btn-text');
          const btnSpinner = document.getElementById('btn-spinner');

          if (form) {
            form.addEventListener('submit', (e) => {
              e.preventDefault();
              if (!alertBox || !submitBtn || !btnText || !btnSpinner) return;

              const formData = new FormData(form);
              const firstname = ((formData.get('firstname') as string) || '').trim();
              const email = ((formData.get('email') as string) || '').trim();
              const phone = ((formData.get('phone') as string) || '').trim();
              const message = ((formData.get('message') as string) || '').trim();

              // Validation
              if (!firstname || !email || !phone || !message) {
                alertBox.className =
                  'block mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200 dark:bg-red-950/40 dark:text-red-300 dark:border-red-900';
                alertBox.textContent =
                  'Mohon lengkapi semua kolom wajib bertanda (*) sebelum mengirim.';
                return;
              }

              // Loading state
              submitBtn.disabled = true;
              btnText.textContent = 'Mengirim Pesan...';
              btnSpinner.classList.remove('hidden');
              alertBox.classList.add('hidden');

              // Simulate network dispatch with realistic feedback
              setTimeout(() => {
                submitBtn.disabled = false;
                btnText.textContent = 'Kirim Pesan';
                btnSpinner.classList.add('hidden');

                // Success state
                alertBox.className =
                  'block mb-4 rounded-lg bg-emerald-50 p-4 text-sm text-emerald-800 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-900';
                alertBox.innerHTML = `<strong>Terima kasih, ${firstname}!</strong> Pesan Anda telah kami terima. Tim Kriya akan menghubungi Anda melalui email atau WhatsApp dalam 1x24 jam.`;
                form.reset();
              }, 600);
            });
          }
        </script>
      </div>
      <!-- End Form -->
    </div>
  </div>
</div>
<!-- End Contact Us -->
