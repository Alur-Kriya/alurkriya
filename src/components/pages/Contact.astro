---
import { Phone, Mail, MapPin } from '@lucide/astro';
---

<!-- Contact Us -->
<div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:gap-16">
      <!-- Info -->
      <div class="flex flex-col gap-y-6 sm:gap-y-10">
        <div class="flex items-center gap-x-4">
          <div
            class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-200"
          >
            <Phone class="size-6" />
          </div>
          <div>
            <h3 class="font-medium text-gray-800 dark:text-neutral-200">Telepon / WhatsApp</h3>
            <p class="mt-1 text-sm text-gray-600 dark:text-neutral-400">
              <a
                href="https://wa.me/6285117428800"
                class="text-blue-600 hover:underline dark:text-blue-500">0851 1742 8800</a
              >
            </p>
          </div>
        </div>

        <div class="flex items-center gap-x-4">
          <div
            class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-200"
          >
            <Mail class="size-6" />
          </div>
          <div>
            <h3 class="font-medium text-gray-800 dark:text-neutral-200">Email</h3>
            <p class="mt-1 text-sm text-gray-600 dark:text-neutral-400">
              <a
                href="mailto:info@kriya.click"
                class="text-blue-600 hover:underline dark:text-blue-500">sarah@kriya.click</a
              >
            </p>
          </div>
        </div>

        <div class="flex items-center gap-x-4">
          <div
            class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-200"
          >
            <MapPin class="size-6" />
          </div>
          <div>
            <h3 class="font-medium text-gray-800 dark:text-neutral-200">Alamat Kantor</h3>
            <p class="mt-1 text-sm text-gray-600 dark:text-neutral-400">
              PT. Alur Kriya Teknologi<br />
              Sunter Kemayoran NO.22 RT.001/003<br />
              Tanjung Priok - Jakarta Utara 14350
            </p>
          </div>
        </div>
      </div>
      <!-- End Info -->

      <!-- Form -->
      <div class="flex flex-col rounded-xl border p-4 sm:p-6 lg:p-8 dark:border-neutral-700">
        <h2 class="mb-8 text-xl font-semibold text-gray-800 dark:text-neutral-200">Kirim Pesan</h2>

        <form>
          <div class="grid gap-4">
            <!-- Grid -->
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="hs-firstname-contacts-1" class="sr-only">Nama Depan</label>
                <input
                  type="text"
                  name="hs-firstname-contacts-1"
                  id="hs-firstname-contacts-1"
                  class="block w-full rounded-lg border-gray-200 px-4 py-3 text-sm focus:border-blue-500 focus:ring-blue-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600"
                  placeholder="Nama Depan"
                />
              </div>

              <div>
                <label for="hs-lastname-contacts-1" class="sr-only">Nama Belakang</label>
                <input
                  type="text"
                  name="hs-lastname-contacts-1"
                  id="hs-lastname-contacts-1"
                  class="block w-full rounded-lg border-gray-200 px-4 py-3 text-sm focus:border-blue-500 focus:ring-blue-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600"
                  placeholder="Nama Belakang"
                />
              </div>
            </div>
            <!-- End Grid -->

            <div>
              <label for="hs-email-contacts-1" class="sr-only">Email</label>
              <input
                type="email"
                name="hs-email-contacts-1"
                id="hs-email-contacts-1"
                autocomplete="email"
                class="block w-full rounded-lg border-gray-200 px-4 py-3 text-sm focus:border-blue-500 focus:ring-blue-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600"
                placeholder="Email"
              />
            </div>

            <div>
              <label for="hs-phone-number-1" class="sr-only">No. Telepon</label>
              <input
                type="text"
                name="hs-phone-number-1"
                id="hs-phone-number-1"
                class="block w-full rounded-lg border-gray-200 px-4 py-3 text-sm focus:border-blue-500 focus:ring-blue-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600"
                placeholder="No. Telepon / WhatsApp"
              />
            </div>

            <div>
              <label for="hs-about-contacts-1" class="sr-only">Pesan</label>
              <textarea
                id="hs-about-contacts-1"
                name="hs-about-contacts-1"
                rows="4"
                class="block w-full rounded-lg border-gray-200 px-4 py-3 text-sm focus:border-blue-500 focus:ring-blue-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600"
                placeholder="Pesan Anda"></textarea>
            </div>
          </div>
          <!-- End Grid -->

          <div class="mt-4 grid">
            <button
              type="submit"
              class="inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-(--color-steel-blue-800) px-4 py-3 text-sm font-medium text-white hover:bg-(--color-steel-blue-700) focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-(--color-steel-blue-700) dark:hover:bg-(--color-steel-blue-600)"
            >
              Kirim Pesan
            </button>
          </div>

          <div class="mt-3 text-center">
            <p class="text-sm text-gray-500 dark:text-neutral-500">
              Kami akan membalas pesan Anda maksimal 1x24 jam.
            </p>
          </div>
        </form>
      </div>
      <!-- End Form -->
    </div>
  </div>
</div>
<!-- End Contact Us -->
