---
// Contact Page Component
---

<!-- Contact Us -->
<div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    
    <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:gap-16">
      <!-- Info -->
      <div class="flex flex-col gap-y-6 sm:gap-y-10">
        <div class="flex items-center gap-x-4">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-200">
            <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div>
            <h3 class="font-medium text-gray-800 dark:text-neutral-200">
              Telepon / WhatsApp
            </h3>
            <p class="mt-1 text-sm text-gray-600 dark:text-neutral-400">
              <a href="https://wa.me/6287785511995" class="text-blue-600 hover:underline dark:text-blue-500">0877 8551 1995</a>
            </p>
          </div>
        </div>
        
        <div class="flex items-center gap-x-4">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-200">
            <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          </div>
          <div>
            <h3 class="font-medium text-gray-800 dark:text-neutral-200">
              Email
            </h3>
            <p class="mt-1 text-sm text-gray-600 dark:text-neutral-400">
              <a href="mailto:info@kriya.click" class="text-blue-600 hover:underline dark:text-blue-500">info@kriya.click</a>
            </p>
          </div>
        </div>

        <div class="flex items-center gap-x-4">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-200">
            <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <div>
            <h3 class="font-medium text-gray-800 dark:text-neutral-200">
              Alamat Kantor
            </h3>
            <p class="mt-1 text-sm text-gray-600 dark:text-neutral-400">
              PT. Alur Kriya Teknologi<br/>
              Sunter Kemayoran NO.22 RT.001/003<br/>
              Tanjung Priok - Jakarta Utara 14350
            </p>
          </div>
        </div>
      </div>
      <!-- End Info -->

      <!-- Form -->
      <div class="flex flex-col rounded-xl border p-4 sm:p-6 lg:p-8 dark:border-neutral-700">
        <h2 class="mb-8 text-xl font-semibold text-gray-800 dark:text-neutral-200">
          Kirim Pesan
        </h2>

        <form>
          <div class="grid gap-4">
            <!-- Grid -->
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="hs-firstname-contacts-1" class="sr-only">Nama Depan</label>
                <input type="text" name="hs-firstname-contacts-1" id="hs-firstname-contacts-1" class="block w-full rounded-lg border-gray-200 px-4 py-3 text-sm focus:border-blue-500 focus:ring-blue-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600" placeholder="Nama Depan">
              </div>

              <div>
                <label for="hs-lastname-contacts-1" class="sr-only">Nama Belakang</label>
                <input type="text" name="hs-lastname-contacts-1" id="hs-lastname-contacts-1" class="block w-full rounded-lg border-gray-200 px-4 py-3 text-sm focus:border-blue-500 focus:ring-blue-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600" placeholder="Nama Belakang">
              </div>
            </div>
            <!-- End Grid -->

            <div>
              <label for="hs-email-contacts-1" class="sr-only">Email</label>
              <input type="email" name="hs-email-contacts-1" id="hs-email-contacts-1" autocomplete="email" class="block w-full rounded-lg border-gray-200 px-4 py-3 text-sm focus:border-blue-500 focus:ring-blue-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600" placeholder="Email">
            </div>

            <div>
              <label for="hs-phone-number-1" class="sr-only">No. Telepon</label>
              <input type="text" name="hs-phone-number-1" id="hs-phone-number-1" class="block w-full rounded-lg border-gray-200 px-4 py-3 text-sm focus:border-blue-500 focus:ring-blue-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600" placeholder="No. Telepon / WhatsApp">
            </div>

            <div>
              <label for="hs-about-contacts-1" class="sr-only">Pesan</label>
              <textarea id="hs-about-contacts-1" name="hs-about-contacts-1" rows="4" class="block w-full rounded-lg border-gray-200 px-4 py-3 text-sm focus:border-blue-500 focus:ring-blue-500 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600" placeholder="Pesan Anda"></textarea>
            </div>
          </div>
          <!-- End Grid -->

          <div class="mt-4 grid">
            <button type="submit" class="inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-(--color-steel-blue-800) px-4 py-3 text-sm font-medium text-white hover:bg-(--color-steel-blue-700) focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-(--color-steel-blue-700) dark:hover:bg-(--color-steel-blue-600)">
              Kirim Pesan
            </button>
          </div>

          <div class="mt-3 text-center">
            <p class="text-sm text-gray-500 dark:text-neutral-500">
              Kami akan membalas pesan Anda maksimal 1x24 jam.
            </p>
          </div>
        </form>
      </div>
      <!-- End Form -->
    </div>
  </div>
</div>
<!-- End Contact Us -->
