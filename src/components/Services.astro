---
import { Globe, CodeXml, Database, Cloud, Cpu, Handshake } from '@lucide/astro';
---

<!-- Icon Blocks -->
<div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-20">
  <div class="mx-auto max-w-2xl pb-6 text-center lg:pb-16">
    <h2 class="text-3xl font-bold text-(--color-ink-black-800) lg:text-4xl dark:text-white">
      Our Services
    </h2>
    <p class="mt-3 dark:text-neutral-300">
      Rangkaian layanan teknologi informasi end-to-end untuk membantu perusahaan membangun,
      mengelola, dan mengoptimalkan sistem digital secara berkelanjutan.
    </p>
  </div>
  <div class="mx-auto max-w-5xl">
    <!-- Grid -->
    <div class="grid gap-6 md:grid-cols-2 lg:gap-12">
      <div class="space-y-6 lg:space-y-10">
        <!-- Icon Block -->
        <div class="flex gap-x-5 sm:gap-x-8">
          <Globe class="mt-2 size-8 shrink-0 text-(--color-ink-black-800) dark:text-white" />
          <div class="grow">
            <h3
              class="text-base font-semibold text-(--color-ink-black-800) sm:text-lg dark:text-neutral-200"
            >
              Website Development
            </h3>
            <p class="mt-1 dark:text-neutral-300">
              Website profesional, cepat, dan aman untuk meningkatkan citra dan performa bisnis
              Anda.
            </p>
          </div>
        </div>
        <!-- End Icon Block -->

        <!-- Icon Block -->
        <div class="flex gap-x-5 sm:gap-x-8">
          <CodeXml class="mt-2 size-8 shrink-0 text-(--color-ink-black-800) dark:text-white" />
          <div class="grow">
            <h3
              class="text-base font-semibold text-(--color-ink-black-800) sm:text-lg dark:text-neutral-200"
            >
              Software Development
            </h3>
            <p class="mt-1 dark:text-neutral-300">
              Solusi aplikasi bisnis yang efisien, scalable, dan mendukung pertumbuhan perusahaan.
            </p>
          </div>
        </div>
        <!-- End Icon Block -->

        <!-- Icon Block -->
        <div class="flex gap-x-5 sm:gap-x-8">
          <Database class="mt-2 size-8 shrink-0 text-(--color-ink-black-800) dark:text-white" />
          <div class="grow">
            <h3
              class="text-base font-semibold text-(--color-ink-black-800) sm:text-lg dark:text-neutral-200"
            >
              Data & System Migration
            </h3>
            <p class="mt-1 dark:text-neutral-300">
              Layanan migrasi data aman dan minim downtime untuk mendukung kelancaran operasional
              perusahaan.
            </p>
          </div>
        </div>
        <!-- End Icon Block -->
      </div>
      <!-- End Col -->

      <div class="space-y-6 lg:space-y-10">
        <!-- Icon Block -->
        <div class="flex gap-x-5 sm:gap-x-8">
          <Cloud class="mt-2 size-8 shrink-0 text-(--color-ink-black-800) dark:text-white" />
          <div class="grow">
            <h3
              class="text-base font-semibold text-(--color-ink-black-800) sm:text-lg dark:text-neutral-200"
            >
              Cloud Hosting & Infrastructure
            </h3>
            <p class="mt-1 dark:text-neutral-300">
              Solusi cloud hosting scalable dan aman untuk meningkatkan fleksibilitas infrastruktur
              IT Anda.
            </p>
          </div>
        </div>
        <!-- End Icon Block -->

        <!-- Icon Block -->
        <div class="flex gap-x-5 sm:gap-x-8">
          <Cpu class="mt-2 size-8 shrink-0 text-(--color-ink-black-800) dark:text-white" />
          <div class="grow">
            <h3
              class="text-base font-semibold text-(--color-ink-black-800) sm:text-lg dark:text-neutral-200"
            >
              IT Procurement & Support
            </h3>
            <p class="mt-1 dark:text-neutral-300">
              Pengadaan perangkat IT terpercaya dengan proses efisien, transparan, dan sesuai
              kebutuhan bisnis.
            </p>
          </div>
        </div>
        <!-- End Icon Block -->

        <!-- Icon Block -->
        <div class="flex gap-x-5 sm:gap-x-8">
          <Handshake class="mt-2 size-8 shrink-0 text-(--color-ink-black-800) dark:text-white" />
          <div class="grow">
            <h3
              class="text-base font-semibold text-(--color-ink-black-800) sm:text-lg dark:text-neutral-200"
            >
              SaaS Partners
            </h3>
            <p class="mt-1 dark:text-neutral-300">
              Solusi SaaS premium yang terintegrasi untuk mendukung produktivitas, keamanan, dan
              pertumbuhan bisnis.
            </p>
          </div>
        </div>
        <!-- End Icon Block -->
      </div>
      <!-- End Col -->
    </div>
    <!-- End Grid -->
  </div>
</div>
<!-- End Icon Blocks -->
