<!-- Stationary Architectural Grid Background (Motion Dial 1 - Calm & Purposeful) -->
<div
  class="pointer-events-none absolute inset-0 -z-1 size-full overflow-hidden opacity-50 dark:opacity-25"
  aria-hidden="true"
>
  <svg class="size-full" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
    <defs>
      <pattern id="arch-grid" width="48" height="48" patternUnits="userSpaceOnUse">
        <path
          d="M 48 0 L 0 0 0 48"
          fill="none"
          stroke="currentColor"
          stroke-width="0.75"
          class="text-neutral-300 dark:text-neutral-700"
          stroke-dasharray="2 4"></path>
        <circle cx="0" cy="0" r="1.5" class="fill-neutral-400 dark:fill-neutral-600"></circle>
      </pattern>
      <radialGradient id="fade-mask" cx="50%" cy="35%" r="65%">
        <stop offset="0%" stop-color="white" stop-opacity="1"></stop>
        <stop offset="100%" stop-color="white" stop-opacity="0"></stop>
      </radialGradient>
      <mask id="radial-fade">
        <rect width="100%" height="100%" fill="url(#fade-mask)"></rect>
      </mask>
    </defs>
    <rect width="100%" height="100%" fill="url(#arch-grid)" mask="url(#radial-fade)"></rect>
  </svg>
</div>
