---
import { getWaUrl } from '@lib/whatsapp';
import { MessageCircle } from '@lucide/astro';

interface Props {
  message?: string;
}

const {
  message = 'Halo Kriya, saya ingin berkonsultasi mengenai layanan dan solusi teknologi dari Kriya.',
} = Astro.props;

const waUrl = getWaUrl(message);
---

<div class="fixed right-5 bottom-5 z-40 sm:right-6 sm:bottom-6">
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Hubungi kami melalui WhatsApp"
    class="group flex min-h-[48px] min-w-[48px] items-center gap-x-2.5 rounded-full bg-[#25D366] p-3.5 text-white shadow-lg shadow-emerald-950/20 transition-all duration-200 hover:bg-[#20ba59] hover:shadow-xl focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:outline-hidden dark:focus-visible:ring-offset-neutral-900"
    id="whatsapp-fab"
    data-analytics-cta="whatsapp"
    data-analytics-location="floating_fab"
  >
    <div class="flex size-6 items-center justify-center">
      <MessageCircle class="size-6 stroke-[2] text-white" />
    </div>

    <!-- Slide-out text label on hover (desktop) -->
    <span
      class="inline-block max-w-0 overflow-hidden text-sm font-semibold whitespace-nowrap transition-all duration-300 ease-in-out group-hover:max-w-48 group-hover:pe-2"
    >
      Chat via WhatsApp
    </span>
  </a>
</div>
