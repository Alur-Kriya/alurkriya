---
import Switcher from '@components/ui/Switcher.astro';
import Icon from '@components/ui/Icon.astro';
import Logo from '@components/ui/Logo.astro';
import { solutions } from '@contents/solutions/solutions.mjs';
import {
  Menu,
  X,
  House,
  Wrench,
  ChevronDown,
  ChevronRight,
  Globe,
  Award,
  CodeXml,
  Users,
  Database,
  Cloud,
  Cpu,
  Handshake,
  Boxes,
  LayoutDashboard,
  Briefcase,
  PhoneCall,
  Moon,
  Network,
} from '@lucide/astro';
---

<header class="sticky inset-x-0 top-0 z-50 flex flex-wrap text-sm md:flex-nowrap md:justify-start">
  <nav
    class="relative mx-2 mt-4 flex w-full max-w-5xl basis-full flex-wrap items-center justify-between rounded-lg bg-white py-2 ps-5 pe-2 md:flex-nowrap md:py-0 lg:mx-auto dark:bg-(--color-deep-space-blue-950)"
  >
    <div class="flex items-center">
      <a
        class="flex-none rounded-md text-xl font-semibold focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300"
        href="/"
        aria-label="Brand"
      >
        <span
          id="brand-icon"
          class="mt-2 inline-block translate-x-0 transform opacity-100 transition-all duration-500 ease-in-out"
        >
          <Icon />
        </span>
        <span
          id="brand-logo"
          class="absolute mt-2 inline-block -translate-x-2 transform opacity-0 transition-all duration-500 ease-in-out"
        >
          <Logo />
        </span>
      </a>
    </div>

    <div class="flex items-center gap-1 md:order-4 md:ms-4">
      <!-- Collapse Button -->
      <button
        type="button"
        class="hs-collapse-toggle relative flex size-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border border-gray-200 text-sm font-medium hover:bg-gray-100 focus:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:ring-offset-2 focus-visible:outline-hidden disabled:pointer-events-none disabled:opacity-50 md:hidden dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-700 dark:focus:bg-neutral-700"
        id="hs-header-base-collapse"
        aria-expanded="false"
        aria-controls="hs-header-base"
        aria-label="Toggle navigation"
        data-hs-collapse="#hs-header-base"
      >
        <Menu class="hs-collapse-open:hidden size-5" />
        <X class="hs-collapse-open:block hidden size-5 shrink-0" />
        <span class="sr-only">Toggle navigation</span>
      </button>
      <!-- End Collapse Button -->
    </div>

    <!-- Collapse -->
    <div
      id="hs-header-base"
      class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 md:block"
      aria-labelledby="hs-header-base-collapse"
    >
      <div
        class="max-h-[75vh] overflow-hidden overflow-y-auto [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-gray-300 dark:[&::-webkit-scrollbar-thumb]:bg-neutral-500 [&::-webkit-scrollbar-track]:bg-gray-100 dark:[&::-webkit-scrollbar-track]:bg-neutral-700"
      >
        <div class="flex flex-col gap-0.5 py-2 md:flex-row md:items-center md:gap-1 md:py-0">
          <div class="grow">
            <div
              class="flex flex-col gap-0.5 font-(family-name:--font-heading) md:flex-row md:items-center md:justify-end md:gap-1"
            >
              <a
                class="flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-semibold text-(--color-ink-black-800) hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                href="/"
              >
                <House class="me-3 block size-4 shrink-0 md:me-2 md:hidden" />
                Beranda
              </a>

              <!-- Solusi Mega Menu -->
              <div
                class="hs-dropdown [--adaptive:none] [--auto-close:inside] [--strategy:static] md:inline-block md:[--strategy:absolute] md:[--trigger:hover]"
              >
                <button
                  id="hs-header-base-mega-menu-solusi"
                  type="button"
                  class="hs-dropdown-toggle flex min-h-[44px] w-full items-center rounded-lg px-3 py-2 text-sm font-semibold text-(--color-ink-black-800) hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                  aria-haspopup="menu"
                  aria-expanded="false"
                  aria-label="Menu Solusi"
                >
                  <Boxes class="me-3 block size-4 shrink-0 md:me-2 md:hidden" />
                  Solusi
                  <ChevronDown
                    class="hs-dropdown-open:-rotate-180 md:hs-dropdown-open:rotate-0 ms-auto size-4 shrink-0 duration-300 md:ms-1"
                  />
                </button>

                <div
                  class="hs-dropdown-menu hs-dropdown-open:opacity-100 relative start-0 top-full z-10 hidden w-full min-w-60 opacity-0 transition-[opacity,margin] duration-[0.1ms] before:absolute before:start-0 before:-top-5 before:h-5 before:w-full"
                  role="menu"
                  aria-orientation="vertical"
                  aria-labelledby="hs-header-base-mega-menu-solusi"
                >
                  <div
                    class="before:light:md:bg-white before:backdrop-blur-lg md:mx-6 md:rounded-b-lg md:bg-white md:shadow-md lg:mx-8 dark:md:bg-(--color-deep-space-blue-950)"
                  >
                    <!-- Grid -->
                    <div class="gap-4 py-1 md:grid md:grid-cols-2 md:p-2 lg:grid-cols-3">
                      <div class="flex flex-col">
                        <!-- Link -->
                        <a
                          class="flex gap-x-4 rounded-lg p-3 hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                          href="/solusi/software-ziswaf-erp"
                        >
                          <LayoutDashboard class="mt-1 size-4 shrink-0 dark:text-neutral-300" />
                          <div class="grow">
                            <p
                              class="text-sm font-semibold text-(--color-ink-black-800) dark:text-neutral-300"
                            >
                              Software ZISWAF ERP
                            </p>
                            <p class="text-sm text-(--color-ink-black-700) dark:text-neutral-400">
                              ERP terpadu untuk fundraising, akuntansi PSAK 109, penyaluran 8 Asnaf,
                              approval PPD, dan SDM amil.
                            </p>
                          </div>
                        </a>
                      </div>
                      <!-- End Col -->

                      <div class="flex flex-col">
                        <!-- Link -->
                        <a
                          class="flex gap-x-4 rounded-lg p-3 hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                          href="/solusi/perluasan-jaringan-internet"
                        >
                          <Network class="mt-1 size-4 shrink-0 dark:text-neutral-300" />
                          <div class="grow">
                            <p
                              class="text-sm font-semibold text-(--color-ink-black-800) dark:text-neutral-300"
                            >
                              Solusi Perluasan Jaringan Internet
                            </p>
                            <p class="text-sm text-(--color-ink-black-700) dark:text-neutral-400">
                              Infrastruktur jaringan cepat, stabil, dan bebas blind spot untuk
                              bisnis, UKM, dan hunian.
                            </p>
                          </div>
                        </a>
                        <!-- End Link -->
                      </div>
                      <!-- End Col -->
                    </div>
                    <!-- End Grid -->

                    <!-- Footer Link -->
                    <div
                      class="flex justify-end border-t border-gray-100 px-4 py-3 md:px-6 dark:border-neutral-800"
                    >
                      <a
                        class="group inline-flex items-center gap-x-1.5 rounded-md text-sm font-semibold text-(--color-steel-blue-700) hover:text-(--color-steel-blue-800) focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-blue-400 dark:hover:text-blue-300"
                        href="/solusi"
                      >
                        Lihat Semua Solusi
                        <ChevronRight
                          class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
                        />
                      </a>
                    </div>
                    <!-- End Footer Link -->
                  </div>
                </div>
              </div>
              <!-- End Solusi Mega Menu -->

              <!-- Layanan Jasa Mega Menu -->
              <div
                class="hs-dropdown [--adaptive:none] [--auto-close:inside] [--strategy:static] md:inline-block md:[--strategy:absolute] md:[--trigger:hover]"
              >
                <button
                  id="hs-header-base-mega-menu-fullwidth"
                  type="button"
                  class="hs-dropdown-toggle flex min-h-[44px] w-full items-center rounded-lg px-3 py-2 text-sm font-semibold text-(--color-ink-black-800) hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                  aria-haspopup="menu"
                  aria-expanded="false"
                  aria-label="Mega Menu"
                >
                  <Wrench class="me-3 block size-4 shrink-0 md:me-2 md:hidden" />
                  Layanan Jasa
                  <ChevronDown
                    class="hs-dropdown-open:-rotate-180 md:hs-dropdown-open:rotate-0 ms-auto size-4 shrink-0 duration-300 md:ms-1"
                  />
                </button>

                <div
                  class="hs-dropdown-menu hs-dropdown-open:opacity-100 relative start-0 top-full z-10 hidden w-full min-w-60 opacity-0 transition-[opacity,margin] duration-[0.1ms] before:absolute before:start-0 before:-top-5 before:h-5 before:w-full"
                  role="menu"
                  aria-orientation="vertical"
                  aria-labelledby="hs-header-base-mega-menu-fullwidth"
                >
                  <div
                    class="before:light:md:bg-white before:backdrop-blur-lg md:mx-6 md:rounded-b-lg md:bg-white md:shadow-md lg:mx-8 dark:md:bg-(--color-deep-space-blue-950)"
                  >
                    <!-- Grid -->
                    <div class="gap-4 py-1 md:grid md:grid-cols-2 md:p-2 lg:grid-cols-3">
                      <div class="flex flex-col">
                        <!-- Link -->
                        <!-- Link -->
                        <a
                          class="flex gap-x-4 rounded-lg p-3 hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                          href="/jasa/website-development"
                        >
                          <Globe class="mt-1 size-4 shrink-0 dark:text-neutral-300" />
                          <div class="grow">
                            <p
                              class="text-sm font-semibold text-(--color-ink-black-800) dark:text-neutral-300"
                            >
                              Website Development
                              <span
                                class="inline-flex items-center gap-x-1 rounded-full bg-red-100 px-1.5 py-1 text-xs font-medium text-red-800 dark:bg-red-500/10 dark:text-neutral-300"
                              >
                                <Award class="size-3 shrink-0" />
                              </span>
                            </p>
                            <p class="text-sm text-(--color-ink-black-700) dark:text-neutral-400">
                              Website profesional, cepat, dan aman untuk meningkatkan citra dan
                              performa bisnis Anda.
                            </p>
                          </div>
                        </a>
                        <!-- End Link -->

                        <!-- Link -->
                        <a
                          class="flex gap-x-4 rounded-lg p-3 hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                          href="/jasa/software-development"
                        >
                          <CodeXml class="mt-1 size-4 shrink-0 dark:text-neutral-300" />
                          <div class="grow">
                            <p
                              class="text-sm font-semibold text-(--color-ink-black-800) dark:text-neutral-300"
                            >
                              Software Development
                              <span
                                class="inline-flex items-center gap-x-1 rounded-full bg-red-100 px-1.5 py-1 text-xs font-medium text-red-800 dark:bg-red-500/10 dark:text-neutral-300"
                              >
                                <Award class="size-3 shrink-0" />
                              </span>
                            </p>
                            <p class="text-sm text-(--color-ink-black-700) dark:text-neutral-400">
                              Solusi aplikasi bisnis yang efisien, scalable, dan mendukung
                              pertumbuhan perusahaan.
                            </p>
                          </div>
                        </a>
                        <!-- End Link -->

                        <!-- Link -->
                        <a
                          class="flex gap-x-4 rounded-lg p-3 hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                          href="/jasa/data-system-migration"
                        >
                          <Database class="mt-1 size-4 shrink-0 dark:text-neutral-300" />
                          <div class="grow">
                            <p
                              class="text-sm font-semibold text-(--color-ink-black-800) dark:text-neutral-300"
                            >
                              Data & System Migration
                            </p>
                            <p class="text-sm text-(--color-ink-black-700) dark:text-neutral-400">
                              Layanan migrasi data aman dan minim downtime untuk mendukung
                              kelancaran operasional perusahaan.
                            </p>
                          </div>
                        </a>
                        <!-- End Link -->
                      </div>
                      <!-- End Col -->

                      <div class="flex flex-col">
                        <!-- Link -->
                        <a
                          class="flex gap-x-4 rounded-lg p-3 hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                          href="/jasa/cloud-hosting"
                        >
                          <Cloud class="mt-1 size-4 shrink-0 dark:text-neutral-300" />
                          <div class="grow">
                            <p
                              class="text-sm font-semibold text-(--color-ink-black-800) dark:text-neutral-300"
                            >
                              Cloud Hosting & Infrastructure
                            </p>
                            <p class="text-sm text-(--color-ink-black-700) dark:text-neutral-400">
                              Solusi cloud hosting scalable dan aman untuk meningkatkan
                              fleksibilitas infrastruktur IT Anda.
                            </p>
                          </div>
                        </a>
                        <!-- End Link -->

                        <!-- Link -->
                        <a
                          class="flex gap-x-4 rounded-lg p-3 hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                          href="/jasa/it-procurement-support"
                        >
                          <Cpu class="mt-1 size-4 shrink-0 dark:text-neutral-300" />
                          <div class="grow">
                            <p
                              class="text-sm font-semibold text-(--color-ink-black-800) dark:text-neutral-300"
                            >
                              IT Procurement & Support
                            </p>
                            <p class="text-sm text-(--color-ink-black-700) dark:text-neutral-400">
                              Pengadaan perangkat IT terpercaya dengan proses efisien, transparan,
                              dan sesuai kebutuhan bisnis.
                            </p>
                          </div>
                        </a>
                        <!-- End Link -->

                        <!-- Link -->
                        <a
                          class="flex gap-x-4 rounded-lg p-3 hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                          href="/jasa/saas-partners"
                        >
                          <Handshake class="mt-1 size-4 shrink-0 dark:text-neutral-300" />
                          <div class="grow">
                            <p
                              class="text-sm font-semibold text-(--color-ink-black-800) dark:text-neutral-300"
                            >
                              SaaS Partners
                            </p>
                            <p class="text-sm text-(--color-ink-black-700) dark:text-neutral-400">
                              Solusi SaaS premium yang terintegrasi untuk mendukung produktivitas,
                              keamanan, dan pertumbuhan bisnis.
                            </p>
                          </div>
                        </a>
                        <!-- End Link -->
                      </div>
                      <!-- End Col -->

                      <div class="flex flex-col">
                        <!-- Link -->
                        <a
                          class="flex gap-x-4 rounded-lg p-3 hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                          href="/jasa/it-consulting"
                        >
                          <Users class="mt-1 size-4 shrink-0 dark:text-neutral-300" />
                          <div class="grow">
                            <p
                              class="text-sm font-semibold text-(--color-ink-black-800) dark:text-neutral-300"
                            >
                              IT Consulting
                            </p>
                            <p class="text-sm text-(--color-ink-black-700) dark:text-neutral-400">
                              Konsultasi IT strategis untuk optimasi sistem, efisiensi operasional,
                              dan percepatan transformasi digital.
                            </p>
                          </div>
                        </a>
                        <!-- End Link -->
                      </div>
                      <!-- End Col -->
                    </div>
                    <!-- End Grid -->

                    <!-- Footer Link -->
                    <div
                      class="flex justify-end border-t border-gray-100 px-4 py-3 md:px-6 dark:border-neutral-800"
                    >
                      <a
                        class="group inline-flex items-center gap-x-1.5 rounded-md text-sm font-semibold text-(--color-steel-blue-700) hover:text-(--color-steel-blue-800) focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-blue-400 dark:hover:text-blue-300"
                        href="/jasa"
                      >
                        Lihat Semua Layanan
                        <ChevronRight
                          class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
                        />
                      </a>
                    </div>
                    <!-- End Footer Link -->
                  </div>
                </div>
              </div>
              <!-- End Layanan Jasa Mega Menu -->

              <a
                class="flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-semibold text-(--color-ink-black-800) hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                href="/portfolio"
              >
                <Briefcase class="me-3 block size-4 shrink-0 md:me-2 md:hidden" />
                Portofolio
              </a>

              <a
                class="flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-semibold text-(--color-ink-black-800) hover:bg-gray-100 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800"
                href="/kontak"
              >
                <PhoneCall class="me-3 block size-4 shrink-0 md:me-2 md:hidden" />
                Kontak
              </a>
            </div>
          </div>

          <div class="my-2 md:mx-2 md:my-0">
            <div class="h-px w-full bg-gray-100 md:h-4 md:w-px md:bg-gray-300 dark:bg-neutral-700">
            </div>
          </div>

          <!-- Button Group -->
          <div class="flex flex-wrap items-center gap-x-1.5">
            <button
              type="button"
              aria-label="Toggle dark mode"
              class="hs-dark-mode-active:hidden hs-dark-mode inline-flex size-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-full font-medium hover:bg-gray-200 focus:bg-gray-200 focus-visible:ring-2 focus-visible:ring-(--color-steel-blue-600) focus-visible:ring-offset-2 focus-visible:outline-hidden dark:text-neutral-300 dark:hover:bg-neutral-800 dark:focus:bg-neutral-800"
              data-hs-theme-click-value="dark"
            >
              <span class="inline-flex size-11 shrink-0 items-center justify-center">
                <Moon class="size-5 shrink-0" />
              </span>
            </button>

            <Switcher />
          </div>
          <!-- End Button Group -->
        </div>
      </div>
    </div>
    <!-- End Collapse -->
  </nav>
</header>

<script>
  const brandIcon = document.getElementById('brand-icon');
  const brandLogo = document.getElementById('brand-logo');

  const updateBrand = () => {
    if (window.scrollY > 50) {
      // Scrolled: Hide Icon, Show Logo
      brandIcon?.classList.add('opacity-0', 'translate-x-2', 'absolute');
      brandIcon?.classList.remove('opacity-100', 'translate-x-0');

      brandLogo?.classList.remove('opacity-0', '-translate-x-2', 'absolute');
      brandLogo?.classList.add('opacity-100', 'translate-x-0');
    } else {
      // Top: Show Icon, Hide Logo
      brandIcon?.classList.remove('opacity-0', 'translate-x-2', 'absolute');
      brandIcon?.classList.add('opacity-100', 'translate-x-0');

      brandLogo?.classList.add('opacity-0', '-translate-x-2', 'absolute');
      brandLogo?.classList.remove('opacity-100', 'translate-x-0');
    }
  };

  window.addEventListener('scroll', updateBrand);
  updateBrand(); // Jalankan saat inisialisasi untuk menangani refresh halaman di posisi scroll
</script>
