---
import TestiSlide from '@components/ui/TestiSlide.astro';
import { Quote, Zap, ShieldCheck, Clock, Layers } from '@lucide/astro';

const commitments = [
  {
    icon: Clock,
    title: '< 24 Jam',
    desc: 'Waktu respon awal konsultasi teknis dan asesmen kebutuhan bisnis Anda.',
  },
  {
    icon: Layers,
    title: 'Modular & Scalable',
    desc: 'Arsitektur sistem dibangun adaptif, siap berkembang seiring ekspansi perusahaan.',
  },
  {
    icon: ShieldCheck,
    title: 'Standar NDA & Keamanan',
    desc: 'Kerahasiaan data dan hak cipta kekayaan intelektual dilindungi kesepakatan resmi.',
  },
  {
    icon: Zap,
    title: 'Dukungan Proaktif',
    desc: 'Pemantauan sistem preventif untuk menjaga keandalan dan meminimalkan gangguan.',
  },
];
---

<!-- Testimonials with Commitments -->
<div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-20">
  <!-- Grid -->
  <div class="text-base lg:grid lg:grid-cols-12 lg:items-center lg:justify-between lg:gap-16">
    <div class="lg:col-span-5 lg:col-start-1">
      <!-- Title -->
      <div class="mb-8">
        <h2
          class="font-heading mb-2 text-3xl font-bold text-gray-800 lg:text-4xl dark:text-neutral-200"
        >
          Kemitraan & Kecepatan Layanan
        </h2>
        <p class="text-gray-600 dark:text-neutral-400">
          Respons cepat, solusi tepat. Kami mendampingi kebutuhan teknologi bisnis Anda dengan
          eksekusi terukur dan transparan.
        </p>
      </div>
      <!-- End Title -->

      <!-- Blockquote -->
      <blockquote class="relative">
        <Quote
          class="absolute start-0 top-0 mx-4 size-16 -translate-x-6 -translate-y-8 transform fill-current text-(--color-deep-space-blue-100) dark:text-(--color-deep-space-blue-950)"
          aria-hidden="true"
        />

        <TestiSlide />
      </blockquote>
      <!-- End Blockquote -->
    </div>
    <!-- End Col -->

    <div class="mt-10 lg:col-span-6 lg:col-end-13 lg:mt-0">
      <div class="space-y-6 sm:space-y-8">
        <!-- List -->
        <ul
          class="grid grid-cols-1 gap-4 divide-y divide-gray-200 overflow-hidden sm:grid-cols-2 sm:divide-y-0 dark:divide-neutral-700"
        >
          {
            commitments.map((item) => (
              <li class="flex flex-col rounded-xl border border-gray-100 bg-white/70 p-5 shadow-2xs dark:border-neutral-800 dark:bg-neutral-900/40">
                <div class="mb-3 flex size-8 items-center justify-center rounded-lg bg-(--color-steel-blue-50) text-(--color-steel-blue-700) dark:bg-neutral-800 dark:text-(--color-steel-blue-300)">
                  <item.icon class="size-4.5" />
                </div>
                <div class="text-lg font-bold text-gray-800 dark:text-neutral-200">
                  {item.title}
                </div>
                <p class="mt-1.5 text-xs leading-relaxed text-gray-600 dark:text-neutral-400">
                  {item.desc}
                </p>
              </li>
            ))
          }
        </ul>
        <!-- End List -->
      </div>
    </div>
    <!-- End Col -->
  </div>
  <!-- End Grid -->
</div>
